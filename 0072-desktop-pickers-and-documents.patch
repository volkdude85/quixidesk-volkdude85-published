+/// The user's Documents folder, as the desktop defines it.
+///
+/// `~/.config/user-dirs.dirs` is how a Linux desktop says where Documents actually is — the folder can
+/// be localised (`~/Documenten`), moved to another mount, or renamed entirely, and the file is the only
+/// authority on which. Reading `~/Documents` blindly puts files in a folder the person never sees in
+/// their file manager, which is exactly the complaint a memory folder should not earn.
+pub fn documents_dir() -> PathBuf {
+    if let Some(path) = user_dir("XDG_DOCUMENTS_DIR") {
+        return path;
+    }
+    home_dir().join("Documents")
+}
+
+/// Any XDG user directory, expanded the way the spec says: `$HOME/...` and a bare path both work.
+pub fn user_dir(key: &str) -> Option<PathBuf> {
+    let config = std::env::var_os("XDG_CONFIG_HOME")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| home_dir().join(".config"))
+        .join("user-dirs.dirs");
+    let text = std::fs::read_to_string(config).ok()?;
+    let prefix = format!("{key}=");
+    for line in text.lines() {
+        let line = line.trim();
+        if !line.starts_with(&prefix) {
+            continue;
+        }
+        let raw = line[prefix.len()..].trim().trim_matches('"');
+        if raw.is_empty() {
+            continue;
+        }
+        let expanded = if let Some(rest) = raw.strip_prefix("$HOME/") {
+            home_dir().join(rest)
+        } else if raw == "$HOME" {
+            home_dir()
+        } else {
+            PathBuf::from(raw)
+        };
+        if expanded.is_dir() {
+            return Some(expanded);
+        }
+    }
+    None
+}
+
