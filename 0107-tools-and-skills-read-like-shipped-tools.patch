diff -urN a/resources/ui/app.css b/resources/ui/app.css
--- a/resources/ui/app.css	2026-11-04 12:21:24.044607131 -0800
+++ b/resources/ui/app.css	2026-11-04 12:21:24.053544858 -0800
@@ -3279,3 +3279,66 @@
   .projects-layout { grid-template-columns: minmax(0, 1fr); }
   .rules-panel { position: static; max-height: none; }
 }
+
+
+/* Proposed entries are no longer painted blue: the whole list is the tooling under consideration, so
+   it reads like any other tool. The `.proposed` class remains as state, not as decoration. */
+.skill-card.proposed { }
+
+
+/* Long unbroken ids (software-development/inspecting-hermes-desktop-dom) set a min-content width the
+   grid cannot shrink below, which pushed the third column off the right edge of a 1280 window. */
+.cards > * { min-width: 0; }
+.skill-card h3 { overflow-wrap: anywhere; }
+.skill-card p { overflow-wrap: anywhere; }
+
+/* Flagged: marked red while reviewing, not ready to ship. */
+.skill-card.flagged {
+  border-color: #ef4444;
+  background: color-mix(in oklab, #ef4444 10%, transparent);
+  box-shadow: inset 3px 0 0 #ef4444;
+}
+.skill-card.flagged h3 { color: #ff9a9a; }
+.skill-card.flagged .tag::after { content: " · needs work"; color: #ff9a9a; }
+.flag-note { color: #ff9a9a; font-size: 11px; }
+
+
+/* The card is a door now: clicking anywhere on it opens the text. */
+.skill-card { cursor: pointer; }
+.skill-card:hover { border-color: var(--accent); }
+.skill-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.skill-card .card-actions { display: flex; gap: 8px; flex-wrap: wrap; }
+
+/* Preview: the real text, readable. */
+.preview { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
+.preview-files { display: flex; gap: 6px; flex-wrap: wrap; }
+.preview-files button.active { color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
+.preview-text {
+  max-height: 58vh; overflow: auto; padding: 12px 14px;
+  border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,0.02);
+  font-size: 12.5px; line-height: 1.55;
+}
+.preview-text h3, .preview-text h4, .preview-text h5, .preview-text h6 { margin: 14px 0 6px; }
+.preview-text p { margin: 8px 0; }
+.preview-text ul { margin: 8px 0 8px 18px; }
+.preview-text li { margin: 3px 0; }
+.preview-text blockquote { margin: 8px 0; padding-left: 10px; border-left: 2px solid var(--line); color: var(--muted); }
+.preview-text code { font-family: ui-monospace, monospace; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 4px; }
+.preview-text pre.skill-file { white-space: pre-wrap; overflow-wrap: anywhere; }
+
+
+
+
+/* Removing the corner controls left the cards stretched to the tallest in the row with a dead gap
+   under the buttons. A column flex with the actions pushed to the bottom uses that height instead of
+   showing it: every card in a row ends on the same line, and a short card looks intentional. */
+.skill-card {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 16px 18px;
+}
+.skill-card h3 { margin: 0; }
+.skill-card p { margin: 0; }
+.skill-card .hint { margin-top: 2px; }
+.skill-card .card-actions { margin-top: auto; padding-top: 10px; }
