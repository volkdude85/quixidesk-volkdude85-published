# makepkg working directories — never commit these
/src/
/pkg/

# build output
*.pkg.tar.zst
*.pkg.tar.xz

# upstream source tarballs are fetched by the PKGBUILD, not vendored
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip

# local backups
*.bak-*
*.orig
*.rej

# Runtime state is never source. A key somebody pasted, the mask of it, the sealed store and the voice
# config all live in the user's data directory — if one of them is ever copied into the tree, this
# keeps it out of a commit.
providers.json
credentials.key
preferences.json
voice.json
.quixi/

# Python bytecode — it embeds the absolute path it was compiled from
__pycache__/
*.pyc

# build output of packaging/debian/build-deb.sh
packaging/debian/dist/
packaging/debian/work/
