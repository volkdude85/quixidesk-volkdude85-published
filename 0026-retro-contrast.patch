+++ b/resources/ui/app.css
@@ -23,11 +23,11 @@
   color-scheme: dark;
   --bg: #040d08;
   --panel: #0e140f;
-  --raised: #111911;
+  --raised: #13251a;
   --sidebar: #020702;
-  --line: #0d2312;
+  --line: #17492a;
   --text: #d9d9d9;
-  --muted: #5c8a66;
+  --muted: #7fb18c;
   --accent: #02d63a;
   --ink: #02150a;
   --danger: #ff6b6b;
@@ -2280,3 +2280,6 @@
 .persona-editor { width: 100%; margin-top: 12px; font-family: ui-monospace, monospace; font-size: 12px; line-height: 1.5;
   background: var(--raised); color: var(--text); border: 1px solid var(--line); border-radius: 10px; padding: 14px; resize: vertical; }
 .persona-editor:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+/* The big line is the one thing on this screen that should carry the accent, not body white. */
+.hero-heading { color: var(--accent); }
