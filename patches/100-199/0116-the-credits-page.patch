+          } else if (head.startsWith("## ")) {
+            nodes.push(el("h2", {}, head.slice(3)));
+            const rest = lines.slice(1).join(" ");
+            if (rest) nodes.push(el("p", {}, ...creditsInline(rest)));
+          } else if (head.startsWith("|")) {
+            continue;  // the table is rendered below, from the manifest
+          } else if (head.startsWith("- ")) {
