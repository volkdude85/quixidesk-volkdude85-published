+  function creditsInline(text) {
+    const out = [];
+    const re = /(\*\*[^*]+\*\*)|(https?:\/\/[^\s),]+)/g;
+    let last = 0;
+    let m;
+    while ((m = re.exec(text)) !== null) {
+      if (m.index > last) out.push(text.slice(last, m.index));
+      if (m[1]) {
+        out.push(el("strong", {}, m[1].slice(2, -2)));
