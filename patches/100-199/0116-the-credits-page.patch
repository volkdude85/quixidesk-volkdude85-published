+        out.push(el("a", {
+          href: "#",
+          class: "credits-link",
+          onclick: (event) => { event.preventDefault(); openExternal(href).catch(() => {}); },
+        }, href));
+      }
+      last = m.index + m[0].length;
+    }
+    if (last < text.length) out.push(text.slice(last));
