+      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.text(); })
+      .then((text) => {
+        // A hard-wrapped markdown file, rendered as blocks rather than as lines. Treating every
+        // line as its own paragraph is what made this page look broken: the source wraps at ~100
+        // characters, so a single sentence became four paragraphs with four gaps in it. Split on
+        // blank lines instead — that is where the author put the paragraph breaks — and join the
+        // wrapped lines back into one run of text before it reaches the page.
+        const blocks = text.replace(/\r\n/g, "\n").split(/\n{2,}/);
+        const nodes = [];
+        for (const block of blocks) {
+          const lines = block.split("\n").map((l) => l.trimEnd()).filter((l) => l.trim());
+          if (!lines.length) continue;
+          const head = lines[0];
+          if (head.startsWith("# ") && lines.length === 1) continue;  // page supplies its own title
+          if (head.startsWith("### ")) {
