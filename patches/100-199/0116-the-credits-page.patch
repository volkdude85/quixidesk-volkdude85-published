+/* Credits, sitting under About. This page should read like a document somebody typeset, not like a
+   settings form and not like raw markdown: one measure, one leading, a clear step between heading
+   levels, and space that belongs to the paragraph rather than leaking between its lines. Eric
+   Hartford is first because everything else in the file is downstream of him. */
+.credits-page { max-width: 68ch; }
+.credits-body { font-size: 14px; line-height: 1.72; }
+/* Space above every heading, none below the first one on the page. */
+.credits-body h2 {
+  margin: 2.1em 0 0.55em;
+  font-size: 16.5px;
+  letter-spacing: -0.01em;
+  color: var(--text);
+}
+.credits-body h3 {
+  margin: 1.6em 0 0.4em;
+  font-size: 14px;
+  font-weight: 650;
+  color: var(--text);
+}
+.credits-body > h2:first-child { margin-top: 0; }
+/* The paragraph owns its bottom margin; the last one does not push the next heading away. */
+.credits-body p { margin: 0 0 0.95em; }
+.credits-body p:last-child { margin-bottom: 0; }
+.credits-body strong { color: var(--text); font-weight: 640; }
+.credits-list { margin: 0 0 1em; padding-left: 1.35em; }
+.credits-list li { margin: 0 0 0.4em; }
+.credits-list li::marker { color: var(--muted); }
+.credits-table { margin-top: 2.4em; }
+.credits-table h2 { margin-top: 0; }
+/* A two-column table with a hanging label column, ruled the way a word processor rules one:
+   a line above every row and one under the last, nothing between. */
+.credits-row {
+  display: grid;
+  grid-template-columns: 20ch minmax(0, 1fr);
+  gap: 1.6em;
+  padding: 0.7em 0;
+  border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
+  align-items: baseline;
+}
+.credits-row:last-child { border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
+.credits-row strong {
+  font-size: 12.5px;
+  font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
+  font-weight: 600;
+  color: var(--text);
+  overflow-wrap: anywhere;
+}
+.credits-tool { font-size: 12.5px; line-height: 1.62; color: var(--muted); overflow-wrap: anywhere; }
+/* A link in a credits page is a name with an address: quiet until you reach for it. */
+.credits-body a.credits-link, .credits-link {
+  color: var(--accent);
+  text-decoration: none;
+  border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
+  overflow-wrap: anywhere;
+}
+.credits-link:hover { border-bottom-color: var(--accent); }
