--- a64/crates/quixi-ipc/src/lib.rs	2026-11-02 14:54:11.910045365 -0800
+++ b64/crates/quixi-ipc/src/lib.rs	2026-11-02 14:54:11.923039137 -0800
@@ -518,6 +518,23 @@
                     Err(error) => json!({ "ok": false, "error": error }),
                 }
             }
+            // Picking where the weights live. A native picker — Dolphin on KDE, the portal elsewhere —
+            // because typing a path to a 20 GB file is a memory test, not a setup step. This one only
+            // returns the choice; it grants nothing.
+            ("LocalModels", "pickFolder") | ("AppPreferences", "pickModelFolder") => {
+                let prompt = args.first().and_then(|v| v.as_str()).unwrap_or("Where are your local models?");
+                match quixi_platform::ComputerUse::pick_folder(Some(prompt)) {
+                    Some(path) => json!({ "ok": true, "path": path }),
+                    None => json!({ "ok": false }),
+                }
+            }
+            ("LocalModels", "pickFile") | ("AppPreferences", "pickModelFile") => {
+                let prompt = args.first().and_then(|v| v.as_str()).unwrap_or("Choose a model file");
+                match quixi_platform::ComputerUse::pick_file(Some(prompt)) {
+                    Some(path) => json!({ "ok": true, "path": path }),
+                    None => json!({ "ok": false }),
+                }
+            }
             // Where the memory palace lives and what is in it. The setup screen needs the real path
             // and the real size — "your memory goes somewhere on disk" is not an answer a person can
             // weigh against a backup drive.
