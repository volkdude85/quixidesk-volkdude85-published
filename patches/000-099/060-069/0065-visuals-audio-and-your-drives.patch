+            // Where the drives actually are. The KDE dialog shows "Computer -> /" and hides the things
+            // people actually store models on, because they are mounted rather than removable. Reading
+            // /proc/mounts is the honest answer to "where are my other drives".
+            ("LocalModels", "mounts") | ("AppPreferences", "mountPoints") => {
+                let mut out: Vec<Value> = Vec::new();
+                if let Ok(text) = std::fs::read_to_string("/proc/mounts") {
+                    for line in text.lines() {
+                        let f: Vec<&str> = line.split_whitespace().collect();
+                        if f.len() < 3 {
+                            continue;
+                        }
+                        let (dev, mount, fstype) = (f[0], f[1], f[2]);
+                        // Real filesystems with capacity, not the kernel's furniture.
+                        if !matches!(fstype, "ext4" | "ext3" | "xfs" | "btrfs" | "exfat" | "ntfs3" | "fuseblk" | "vfat" | "zfs") {
+                            continue;
+                        }
+                        if mount.starts_with("/proc") || mount.starts_with("/sys") || mount.starts_with("/dev") {
+                            continue;
+                        }
+                        if ["/", "/boot", "/boot/efi", "/home", "/var", "/tmp", "/var/log", "/var/cache", "/nix"].contains(&mount) {
+                            continue;
+                        }
+                        out.push(json!({
+                            "device": dev,
+                            "path": mount.replace("\\040", " "),
+                            "fstype": fstype,
+                        }));
+                    }
+                }
+                out.sort_by(|a, b| a["path"].as_str().unwrap_or("").cmp(b["path"].as_str().unwrap_or("")));
+                json!({ "mounts": out })
+            }
