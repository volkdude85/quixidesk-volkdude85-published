+    /// A Custom Endpoint pointed at Ollama's hosted API *is* Ollama Cloud, so it should be called
+    /// that. This moves the credential, the model and the active-pointer across once, then blanks the
+    /// custom slot so the same secret is not held in two places. It runs on load and is idempotent:
+    /// after it has run the conditions no longer hold.
+    fn adopt_custom_endpoint_as_ollama_cloud(catalog: &mut ProvidersStateFile) -> bool {
+        let is_ollama_host = |url: &str| {
+            let u = url.to_ascii_lowercase();
+            u.contains("ollama.com")
+        };
+        let custom = catalog.providers.iter().find(|p| p.id == "custom").cloned();
+        let Some(custom) = custom else { return false };
+        if custom.api_key_raw.trim().is_empty() || !is_ollama_host(&custom.base_url) {
+            return false;
+        }
+        let cloud_clear = catalog
+            .providers
+            .iter()
+            .find(|p| p.id == "ollama-cloud")
+            .map(|p| p.api_key_raw.trim().is_empty())
+            .unwrap_or(false);
+        if !cloud_clear {
+            return false;
+        }
+        let model = custom.selected_model.clone();
+        let masked = custom.api_key_masked.clone();
+        for entry in catalog.providers.iter_mut() {
+            if entry.id == "ollama-cloud" {
+                entry.api_key_raw = custom.api_key_raw.clone();
+                entry.api_key_masked = masked.clone();
+                entry.configured = true;
+                if !model.trim().is_empty() {
+                    entry.selected_model = model.clone();
+                }
+            } else if entry.id == "custom" {
+                // The slot goes back to being a generic endpoint rather than holding a second copy.
+                entry.api_key_raw = String::new();
+                entry.api_key_masked = String::new();
+                entry.base_url = "http://localhost:8000/v1".to_string();
+                entry.configured = false;
+            }
+        }
+        if catalog.active_provider == "custom" {
+            catalog.active_provider = "ollama-cloud".to_string();
+            if !model.trim().is_empty() {
+                catalog.active_model = model;
+            }
+        }
+        true
+    }
