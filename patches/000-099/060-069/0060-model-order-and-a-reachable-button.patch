--- a60/resources/ui/app.css	2026-11-02 14:40:03.513698940 -0800
+++ b60/resources/ui/app.css	2026-11-02 14:40:10.010333954 -0800
@@ -2633,3 +2633,29 @@
   border-bottom: 1px solid var(--line); vertical-align: middle;
 }
 .first-run-table td { padding: 8px 0; border-bottom: 1px solid var(--line); }
+
+/* Onboarding has to survive a quarter-screen window: scroll when it cannot fit, and shrink the
+   spacing before it shrinks the type. Before this, at 960x540 the Connect button sat below the fold
+   with no way to reach it. */
+.first-run {
+  max-height: 100%;
+  overflow-y: auto;
+  padding-bottom: 40px;
+  scrollbar-gutter: stable;
+}
+@media (max-height: 700px) {
+  .first-run { margin-top: 3vh; padding-inline: 16px; }
+  .first-run h1 { font-size: 21px; margin-bottom: 6px; }
+  .first-run-lead { font-size: 13px; margin-bottom: 16px; }
+  .first-run-card { padding: 14px; }
+  .first-run-card h2 { font-size: 13.5px; }
+  .first-run-blurb { font-size: 12px; margin-bottom: 10px; }
+  .first-run-actions { gap: 7px; }
+  .first-run-foot { margin-top: 12px; font-size: 11.5px; }
+  .first-run-grid { gap: 10px; }
+  .first-run-table th, .first-run-table td { padding-block: 5px; }
+}
+@media (max-width: 900px) {
+  .first-run { padding-inline: 14px; }
+  .first-run-grid { grid-template-columns: 1fr; }
+}
