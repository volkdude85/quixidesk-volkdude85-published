     use super::*;
 
+    /// A socket inode outlives the process behind it, so a filesystem check reports a daemon that
+    /// is not there. This is the difference between `exists()` and `connect()`, and it is not
+    /// theoretical: on the development box a stale `/run/user/1000/.ydotool_socket` left over from
+    /// the previous day made `quixi --capabilities` advertise `input_synthesis: true` while
+    /// ydotoold was not running and every synthesized event failed.
+    ///
+    /// Bind, drop the listener, and the file stays while nothing answers — the exact state that
+    /// lied.
+    #[test]
+    fn a_stale_socket_file_is_not_a_live_daemon() {
+        let dir = std::env::temp_dir().join(format!("quixi-socket-liveness-{}", std::process::id()));
+        let _ = std::fs::create_dir_all(&dir);
+        let path = dir.join("dead.sock");
+        let _ = std::fs::remove_file(&path);
+
+        {
+            let listener = std::os::unix::net::UnixListener::bind(&path)
+                .expect("binding a unix socket in the temp dir");
+            assert!(socket_is_live(&path), "a bound listener must read as live");
+            // Dropping the listener does not unlink the socket file.
+            drop(listener);
+        }
+
+        assert!(
+            path.exists(),
+            "the socket inode is expected to survive the listener — that is the whole defect"
+        );
+        assert!(
+            !socket_is_live(&path),
+            "a socket file with nothing behind it must not be reported as available"
+        );
+
+        let _ = std::fs::remove_file(&path);
+        let _ = std::fs::remove_dir(&dir);
+    }
