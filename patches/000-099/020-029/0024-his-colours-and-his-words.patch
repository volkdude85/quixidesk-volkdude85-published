+:root[data-theme="retro"] {
+  color-scheme: dark;
+  --bg: #040d08;
+  --panel: #0e140f;
+  --raised: #111911;
+  --sidebar: #020702;
+  --line: #0d2312;
+  --text: #d9d9d9;
+  --muted: #5c8a66;
+  --accent: #02d63a;
+  --ink: #02150a;
+  --danger: #ff6b6b;
+  --shadow: 0 24px 80px #000a, 0 2px 8px #0006;
+}
 :root[data-theme="light"] {
   color-scheme: light;
   --bg: #fcfcfa;
