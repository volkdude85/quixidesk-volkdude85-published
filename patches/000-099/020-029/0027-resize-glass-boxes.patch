@@ -2283,3 +2299,38 @@
 
 /* The big line is the one thing on this screen that should carry the accent, not body white. */
 .hero-heading { color: var(--accent); }
+
+/* ---- appearance options: translucency and heavier boxing ---- */
+/* Panels can be translucent where the compositor supports it; where it does not, the same colours
+   are simply opaque and nothing breaks. */
+@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
+  :root[data-translucent="on"] .sidebar {
+    background: color-mix(in srgb, var(--sidebar) 82%, transparent);
+    -webkit-backdrop-filter: blur(14px) saturate(1.1);
+    backdrop-filter: blur(14px) saturate(1.1);
+  }
+  :root[data-translucent="on"] .panel,
+  :root[data-translucent="on"] .settings-content,
+  :root[data-translucent="on"] .toolbar {
+    background: color-mix(in srgb, var(--panel) 86%, transparent);
+    -webkit-backdrop-filter: blur(10px);
+    backdrop-filter: blur(10px);
+  }
+}
+/* Boxing: everything that holds content gets a defined edge, so the page has structure instead of
+   floating text on a black field. */
+:root[data-boxing="on"] .composer,
+:root[data-boxing="on"] .suggestion,
+:root[data-boxing="on"] .panel,
+:root[data-boxing="on"] .settings-content,
+:root[data-boxing="on"] .provider-card {
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  box-shadow: 0 1px 0 color-mix(in srgb, var(--accent) 8%, transparent) inset;
+}
+:root[data-boxing="on"] .composer:focus-within { border-color: var(--accent); }
+
+/* Settings switches for the surface options. */
+.toggle-row { display: flex; gap: 22px; flex-wrap: wrap; margin: 10px 0 4px; }
+.toggle { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text); cursor: pointer; }
+.toggle input { accent-color: var(--accent); width: 16px; height: 16px; }
