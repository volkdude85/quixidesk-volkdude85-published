+            // The persona is a file, not a preference blob: the interface reads and writes it
+            // through here so it can show which persona is actually loaded.
+            ("AppPreferences", "getPersona") | ("Persona", "getPersona") => {
+                let (name, body) = self.engine.persona();
+                let path = self.engine.persona_path();
+                json!({
+                    "name": if name.is_empty() { "None loaded".to_string() } else { name },
+                    "path": path.to_string_lossy(),
+                    "content": body.clone(),
+                    "bytes": body.len(),
+                    "loaded": !body.trim().is_empty(),
+                })
+            }
+            ("AppPreferences", "setPersona") | ("Persona", "setPersona") => {
+                let body = args
+                    .first()
+                    .and_then(|v| v.get("content"))
+                    .and_then(|v| v.as_str())
+                    .unwrap_or_default();
+                match self.engine.save_persona(body) {
+                    Ok(()) => {
+                        let (name, _) = self.engine.persona();
+                        self.engine.emit_eipc(
+                            "quixi.settings",
+                            "AppPreferences",
+                            "personaChanged",
+                            json!({ "name": name }),
+                        );
+                        json!({ "ok": true, "name": name })
+                    }
+                    Err(error) => json!({ "ok": false, "error": error }),
+                }
+            }
