+/// Which build this is. The packaging sets QUIXI_EDITION_LABEL when it compiles, so a
+/// single source tree produces every edition: a personal build says so in the title bar,
+/// and a stock build keeps upstream's name with no prefix at all. Nothing here changes
+/// behaviour — it is the difference between two packages you cannot otherwise tell apart
+/// once they are both installed.
+const EDITION_LABEL: &str = match option_env!("QUIXI_EDITION_LABEL") {
+    Some(label) => label,
+    None => "",
+};
+
+/// The label this *running* copy goes by.
+///
+/// Compile-time is the right default — a package bakes in which edition it is — but a build tree is
+/// not a package, and two trees built by hand are otherwise indistinguishable on screen. A one-line
+/// file next to the resources wins over the constant when it exists, so "which window am I looking
+/// at" is answerable without a rebuild. The packaged editions ship that file; the compiler flag is
+/// the fallback.
+fn edition_label(resources_dir: &std::path::Path) -> String {
+    let raw = std::fs::read_to_string(resources_dir.join("edition.txt"))
+        .ok()
+        .unwrap_or_else(|| EDITION_LABEL.to_string());
