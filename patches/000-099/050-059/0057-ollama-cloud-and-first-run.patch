+    // every edition.txt to end with a space, which is exactly the detail a hand-edited file loses.
+    let trimmed = raw.trim();
+    if trimmed.is_empty() {
+        String::new()
+    } else {
+        format!("{trimmed} ")
+    }
+}
 
