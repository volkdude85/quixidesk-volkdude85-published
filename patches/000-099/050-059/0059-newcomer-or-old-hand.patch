   border-radius: 3px; border: 1px solid var(--accent); color: var(--accent); font-weight: 700;
 }
+
+/* The sidebar is 228px and the brand sits above the nav: one row, and never taller than the row. */
+.brand { min-width: 0; }
+.brand > span { min-width: 0; display: flex; flex-direction: column; justify-content: center; }
+.brand .brand-caption {
+  display: block; font-size: 9.5px; font-weight: 500; letter-spacing: .04em;
+  color: var(--muted); text-transform: none; white-space: nowrap;
+  overflow: hidden; text-overflow: ellipsis; max-width: 150px; line-height: 1.1;
+}
+.brand .edition-label { font-size: 9px; letter-spacing: .08em; line-height: 1.1; }
+.brand { height: auto; min-height: 36px; padding-block: 6px; }
+
+/* Narrow windows: the top bar is the first thing to collide. Give it smaller targets and shorter
+   labels before anything is allowed to overlap. */
+@media (max-width: 1200px) {
+  .topbar { padding: 0 14px; gap: 6px; }
+  .topbar .chip-menu-btn { height: 26px; padding: 0 8px; font-size: 11.5px; }
+  .topbar .chip-label { max-width: 130px; }
+  .page { padding: 22px 20px 44px; }
+  .page-header { gap: 10px; }
+  .page-header h1 { font-size: 22px; }
+}
+@media (max-width: 1040px) {
+  .topbar .chip-label { max-width: 92px; }
+  .topbar .chip-caret { display: none; }
+}
+
+/* The quick-setup table: four rows, no ceremony. */
+.first-run-table { border-collapse: collapse; width: 100%; max-width: 560px; margin: 4px 0 6px; }
+.first-run-table th {
+  text-align: left; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase;
+  color: var(--muted); font-weight: 600; width: 108px; padding: 8px 10px 8px 0;
+  border-bottom: 1px solid var(--line); vertical-align: middle;
+}
+.first-run-table td { padding: 8px 0; border-bottom: 1px solid var(--line); }
