+/* Sidebar tree: full-width rows, caret in a fixed gutter so every label lines up, children
+   indented under a guide rail. Nothing here is a floating shape. */
+.nav-group { display: flex; flex-direction: column; gap: 1px; }
+.nav-row { display: flex; align-items: center; gap: 0; border-radius: 8px; }
+.nav-row:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
+.nav-disclosure { flex: 0 0 26px; width: 26px; height: 100%; display: grid; place-items: center;
+  background: none; border: 0; cursor: pointer; color: var(--muted); padding: 0; border-radius: 8px 0 0 8px; }
+.nav-disclosure:hover { color: var(--accent); }
+.nav-caret { width: 0; height: 0; border-left: 4.5px solid transparent; border-right: 4.5px solid transparent;
+  border-top: 6px solid currentColor; transition: transform .14s ease; display: block; }
+/* closed: points down (it opens downward). open: flipped up (it closes upward). */
+.nav-caret.open { transform: rotate(180deg); }
+.nav-group.is-open > .nav-row { background: color-mix(in srgb, var(--accent) 14%, transparent); }
+.nav-group.is-open > .nav-row .nav-caret { color: var(--accent); }
+.nav-children { display: flex; flex-direction: column; gap: 1px; margin: 1px 0 3px 26px;
+  padding-left: 10px; border-left: 1px solid var(--line); }
+.nav-child { display: block; width: 100%; text-align: left; background: none; border: 0; color: var(--muted);
+  font-size: 12px; line-height: 1.2; padding: 6px 8px; border-radius: 6px; cursor: pointer;
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.nav-child:hover, .nav-child:focus-visible { color: var(--text); background: var(--raised); outline: none; }
+.nav-child:focus-visible { box-shadow: inset 0 0 0 1px var(--accent); }
