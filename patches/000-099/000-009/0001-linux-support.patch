+// Integration tests for the Linux ComputerUse layer.
+//
+// These run against the REAL session — real spectacles, real clipboard, real
+// compositor queries — not mocks. Anything that would inject input into the
+// operator's desktop (typing, clicking) is intentionally excluded; those are
+// verified separately and by hand.
+//
+// Run with a live session:
+//   XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
+//   DISPLAY=:0 WAYLAND_DISPLAY=wayland-1 XDG_SESSION_TYPE=wayland \
+//   cargo test -p quixi-platform --test linux_computer_use -- --nocapture --test-threads=1
+
+#![cfg(target_os = "linux")]
+
+use quixi_platform::linux;
+
+#[test]
+fn capability_probe_matches_installed_tools() {
+    let caps = linux::capabilities();
+    println!("{caps:#?}");
+    assert_eq!(caps.session_type, "wayland", "expected a Wayland session");
+    assert!(caps.screenshot, "screenshot backend must be detected");
+    assert!(
+        !caps.screenshot_backend.is_empty(),
+        "backend name must not be empty"
+    );
+    assert!(caps.clipboard, "wl-clipboard must be detected");
+    assert!(caps.file_pickers, "kdialog or zenity must be detected");
+    assert!(caps.display_listing, "kscreen-doctor must be detected");
+    assert!(caps.app_launch, "gtk-launch or gio must be detected");
+}
+
+#[test]
+fn screenshot_returns_a_real_png() {
+    let bytes = linux::screenshot_png().expect("screenshot must succeed on a live session");
+    assert!(
+        bytes.starts_with(b"\x89PNG"),
+        "capture must return PNG magic, got {:?}",
+        &bytes[..bytes.len().min(8)]
+    );
+    assert!(
+        bytes.len() > 50_000,
+        "a full-desktop PNG should be far larger than 50 KB, got {} bytes",
+        bytes.len()
+    );
+    // PNG IHDR carries width/height as big-endian u32 at offset 16.
+    let width = u32::from_be_bytes([bytes[16], bytes[17], bytes[18], bytes[19]]);
+    let height = u32::from_be_bytes([bytes[20], bytes[21], bytes[22], bytes[23]]);
+    println!("captured {}x{} ({} bytes)", width, height, bytes.len());
+    assert!(width >= 1280, "width looks wrong: {width}");
+    assert!(height >= 720, "height looks wrong: {height}");
+}
+
+#[test]
+fn region_capture_is_smaller_than_full_capture() {
+    let full = linux::screenshot_png().expect("full capture");
+    let region = linux::screenshot_region_png(100, 100, 400, 300).expect("region capture");
+    assert!(region.starts_with(b"\x89PNG"), "region must be a PNG");
+    let rw = u32::from_be_bytes([region[16], region[17], region[18], region[19]]);
+    let rh = u32::from_be_bytes([region[20], region[21], region[22], region[23]]);
+    println!("region {}x{} vs full {} bytes", rw, rh, full.len());
+    assert_eq!((rw, rh), (400, 300), "region must be cropped to the request");
+    assert!(
+        region.len() < full.len(),
+        "a 400x300 crop must be smaller than the full desktop"
+    );
+}
+
+#[test]
+fn clipboard_roundtrips_exactly() {
+    let marker = format!("quixidesk-clipboard-{}", std::process::id());
+    linux::clipboard_write(&marker).expect("clipboard write must succeed");
+    let read_back = linux::clipboard_read().expect("clipboard read must succeed");
+    assert_eq!(read_back, marker, "clipboard must return what was written");
+}
+
+#[test]
+fn displays_report_plausible_geometry() {
+    let found = linux::displays();
+    println!("{found:#?}");
+    assert!(!found.is_empty(), "at least one connected display expected");
+    for d in &found {
+        assert!(d.width >= 640, "width implausible: {} on {}", d.width, d.name);
+        assert!(d.height >= 480, "height implausible: {} on {}", d.height, d.name);
+        assert!(d.scale > 0.5 && d.scale < 4.0, "scale implausible: {}", d.scale);
+        assert!(!d.name.is_empty(), "display must have a name");
+    }
+}
+
+#[test]
+fn installed_apps_are_well_formed() {
+    let apps = linux::installed_apps();
+    println!("{} applications found", apps.len());
+    assert!(
+        apps.len() > 10,
+        "expected a populated application menu, got {}",
+        apps.len()
+    );
+    for (name, exec, path) in &apps {
+        assert!(!name.is_empty(), "app name must not be empty");
+        assert!(!exec.is_empty(), "exec line must not be empty for {name}");
+        assert!(
+            path.ends_with(".desktop"),
+            "path must be a .desktop file: {path}"
+        );
+        assert!(
+            std::path::Path::new(path).exists(),
+            "desktop file must exist on disk: {path}"
+        );
+    }
+}
+
+#[test]
+fn unknown_application_is_an_error_not_a_silent_success() {
+    let err = linux::open_application("definitely-not-installed-xyzzy").unwrap_err();
+    println!("error as expected: {err}");
+    assert!(
+        err.to_string().contains("not found"),
+        "unknown apps must report not found, got: {err}"
+    );
+}
--- a/crates/quixi-platform/tests/stress.rs
+++ b/crates/quixi-platform/tests/stress.rs
@@ -0,0 +1,292 @@
+// Stress and soak tests for the Linux ComputerUse layer.
+//
+// These answer three questions the acceptance tests do not: does throughput hold
+// up, do resources leak, and does anything degrade after repetition. Every case
+// prints its measured numbers so a regression is visible as a number rather than
+// a vibe.
+//
+//   cargo test --release -p quixi-platform --test stress -- --test-threads=1 --nocapture
+//
+// Input cases need QUIXI_INPUT_TEST=1 and a focused throwaway terminal.
+
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use quixi_platform::linux;
+use std::time::{Duration, Instant};
+
+fn input_armed() -> bool {
+    matches!(
+        std::env::var("QUIXI_INPUT_TEST").ok().as_deref(),
+        Some("1") | Some("true") | Some("yes")
+    )
+}
+
+fn open_fds() -> usize {
+    std::fs::read_dir("/proc/self/fd")
+        .map(|d| d.count())
+        .unwrap_or(0)
+}
+
+fn rss_kb() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmRSS:"))
+                .and_then(|l| l.split_whitespace().nth(1).map(|n| n.to_string()))
+        })
+        .and_then(|n| n.parse().ok())
+        .unwrap_or(0)
+}
+
+// ---------------------------------------------------------------------------
+// Clipboard throughput and leak behaviour
+// ---------------------------------------------------------------------------
+
+#[test]
+fn clipboard_large_payloads_roundtrip_exactly() {
+    // 64 KiB is the practical ceiling for a selection on most compositors; go
+    // well past it to find the cliff rather than assume one.
+    for size in [1_000usize, 64 * 1024, 1024 * 1024] {
+        let payload: String = (0..size)
+            .map(|i| (b'a' + (i % 26) as u8) as char)
+            .collect();
+        let t = Instant::now();
+        linux::clipboard_write(&payload).expect("clipboard_write must not fail");
+        let w = t.elapsed();
+        let t = Instant::now();
+        let back = linux::clipboard_read().unwrap_or_default();
+        let r = t.elapsed();
+        println!(
+            "clipboard {:>8} bytes  write={:>7.1}ms  read={:>7.1}ms  match={}",
+            size,
+            w.as_secs_f64() * 1000.0,
+            r.as_secs_f64() * 1000.0,
+            back.len() == payload.len() && back == payload
+        );
+        assert_eq!(back.len(), payload.len(), "clipboard truncated {size} bytes");
+        assert_eq!(back, payload, "clipboard corrupted {size} bytes");
+        // A write that blocks is the historical deadlock; cap it hard.
+        assert!(w < Duration::from_secs(10), "clipboard_write blocked: {w:?}");
+    }
+}
+
+#[test]
+fn clipboard_repeated_use_does_not_leak() {
+    let fds_before = open_fds();
+    let rss_before = rss_kb();
+    for i in 0..50 {
+        let s = format!("stress-{i}");
+        linux::clipboard_write(&s).expect("write must not fail");
+        let _ = linux::clipboard_read();
+    }
+    let fds_after = open_fds();
+    let rss_after = rss_kb();
+    println!(
+        "clipboard x50  fd {}->{}  rss {}->{} KiB",
+        fds_before, fds_after, rss_before, rss_after
+    );
+    assert!(
+        fds_after <= fds_before + 5,
+        "file descriptor leak: {fds_before} -> {fds_after}"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Screenshot throughput
+// ---------------------------------------------------------------------------
+
+#[test]
+fn screenshots_sustain_throughput_without_leaking() {
+    let fds_before = open_fds();
+    let n = 25;
+    let t = Instant::now();
+    let mut bytes = 0usize;
+    for _ in 0..n {
+        let png = linux::screenshot_png().expect("screenshot must succeed");
+        bytes += png.len();
+    }
+    let elapsed = t.elapsed();
+    let fds_after = open_fds();
+    println!(
+        "screenshots x{}  total={:.1}ms  per={:.1}ms  avg_size={} KiB  fd {}->{}",
+        n,
+        elapsed.as_secs_f64() * 1000.0,
+        elapsed.as_secs_f64() * 1000.0 / n as f64,
+        bytes / n / 1024,
+        fds_before,
+        fds_after
+    );
+    assert!(fds_after <= fds_before + 5, "fd leak capturing screenshots");
+    let per_capture = elapsed.as_secs_f64() / n as f64;
+    assert!(
+        per_capture < 5.0,
+        "a screenshot taking >5s is a hang, not slowness"
+    );
+}
+
+#[test]
+fn region_capture_is_cheaper_than_full_frame() {
+    let t = Instant::now();
+    let full = linux::screenshot_png().expect("full capture");
+    let full_ms = t.elapsed().as_secs_f64() * 1000.0;
+    let t = Instant::now();
+    let small = linux::screenshot_region_png(0, 0, 320, 200).expect("region capture");
+    let small_ms = t.elapsed().as_secs_f64() * 1000.0;
+    println!(
+        "capture  full={:.0}ms ({} KiB)  region320x200={:.0}ms ({} KiB)",
+        full_ms,
+        full.len() / 1024,
+        small_ms,
+        small.len() / 1024
+    );
+    assert!(
+        small.len() < full.len(),
+        "a 320x200 region should not produce a larger payload than the full frame"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Probe / enumeration soak
+// ---------------------------------------------------------------------------
+
+#[test]
+fn capability_probe_sustains_and_does_not_leak() {
+    let fds_before = open_fds();
+    let t = Instant::now();
+    let n = 200;
+    for _ in 0..n {
+        let c = linux::capabilities();
+        assert!(!c.session_type.is_empty());
+    }
+    let elapsed = t.elapsed();
+    let fds_after = open_fds();
+    println!(
+        "capabilities x{}  total={:.1}ms  per={:.2}ms  fd {}->{}",
+        n,
+        elapsed.as_secs_f64() * 1000.0,
+        elapsed.as_secs_f64() * 1000.0 / n as f64,
+        fds_before,
+        fds_after
+    );
+    assert!(fds_after <= fds_before + 5, "fd leak probing capabilities");
+}
