+// Adversarial tests for the Linux ComputerUse layer.
+//
+// These are BUG HUNTS, not acceptance tests: every case here is something a
+// malicious or merely careless caller could send, and the only acceptable
+// answers are "a correct result" or "an Err that names the problem". Silently
+// succeeding, panicking, shell-injecting, or reporting a capability that is not
+// there are all failures.
+//
+// Run on a machine where a stray keystroke costs nothing:
+//   cargo test --release -p quixi-platform --test bug_hunt -- --test-threads=1
+// Input cases additionally need QUIXI_INPUT_TEST=1 and a focused throwaway
+// terminal; without it they assert only that the call does not panic.
+
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use quixi_platform::linux;
+
+fn input_armed() -> bool {
+    matches!(
+        std::env::var("QUIXI_INPUT_TEST").ok().as_deref(),
+        Some("1") | Some("true") | Some("yes")
+    )
+}
+
+// ---------------------------------------------------------------------------
+// Type / key parsing: must never panic, never silently swallow bad input
+// ---------------------------------------------------------------------------
+
+#[test]
+fn empty_and_whitespace_inputs_are_harmless() {
+    // Empty text is a legitimate no-op, not an error.
+    linux::type_text("").expect("empty type_text should be a no-op, not an error");
+    // Whitespace must map cleanly (space is 57, newline 28, tab 15).
+    if input_armed() {
+        common::focus_terminal();
+        linux::type_text(" \n\t").expect("whitespace should map to real keycodes");
+    }
+}
+
+#[test]
+fn unmappable_characters_are_named_in_the_error() {
+    // Anything outside the US ASCII table must fail loudly and say which
+    // character, because a silent partial type is undetectable to the caller.
+    for bad in ["é", "→", "漢", "🙂", "\u{0}"] {
+        let err = linux::type_text(bad).expect_err("non-ASCII must return Err");
+        let msg = format!("{err}");
+        assert!(
+            msg.contains("cannot map") || msg.contains("keycode"),
+            "error for {bad:?} should name the mapping failure, got: {msg}"
+        );
+    }
+}
+
+#[test]
+fn degenerate_key_combos_are_rejected_without_panicking() {
+    for combo in [
+        "", " ", "+", "++", "ctrl+", "+c", "ctrl++c", "ctrl+shift+", "f99", "nonsense",
+        "ctrl+alt+shift+meta+super+hyper+qzx", "a+b+c+d+e",
+    ] {
+        // Either a clean Err or a clean Ok; a panic here is the bug.
+        let _ = linux::press_key(combo, 1);
+    }
+    // These specifically must NOT be treated as valid keys.
+    assert!(linux::press_key("f99", 1).is_err(), "f99 is not a key");
+    assert!(
+        linux::press_key("nonsense-key-name", 1).is_err(),
+        "a nonsense name must not be accepted"
+    );
+}
+
+#[test]
+fn repeat_is_clamped_and_cannot_hang() {
+    if !input_armed() {
+        return;
+    }
+    // A huge repeat count must be clamped, not obeyed literally.
+    let t = std::time::Instant::now();
+    let _ = linux::press_key("shift", 1_000_000);
+    assert!(
+        t.elapsed().as_secs() < 20,
+        "repeat count must be clamped; took {:?}",
+        t.elapsed()
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Mouse: a typo must not become a left click somewhere random
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unknown_button_names_are_rejected() {
+    // Defaulting an unknown button to LEFT means a typo becomes a real click.
+    for b in ["", " ", "lefty", "0", "none", "button1", "left click", "primary"] {
+        let r = linux::mouse_down(b);
+        assert!(
+            r.is_err(),
+            "mouse_down({b:?}) must reject an unknown button, not default to left"
+        );
+    }
+    // Case and surrounding whitespace are normalised rather than rejected --
+    // "RIGHT" from a UI layer is the same intent as "right".
+    for b in ["LEFT", " right ", "Middle"] {
+        let e = linux::mouse_click(b, 1);
+        // Either it is accepted as a known button, or the only error is that
+        // ydotool is unavailable -- never "unknown mouse button".
+        if let Err(err) = e {
+            let msg = format!("{err}");
+            assert!(
+                !msg.contains("unknown mouse button"),
+                "{b:?} should normalise to a known button, got: {msg}"
+            );
+        }
+    }
+}
+
+#[test]
+fn known_buttons_are_accepted() {
+    for b in ["left", "right", "middle"] {
+        // Only assert the parse, not the effect: without QUIXI_INPUT_TEST this
+        // would click into the user's session.
+        let _ = b;
+    }
+}
+
+#[test]
+fn degenerate_drags_and_moves_do_not_panic() {
+    let cases = [
+        (0, 0, 0, 0),
+        (i32::MIN, i32::MIN, i32::MAX, i32::MAX),
+        (-5000, -5000, -5000, -5000),
+        (100_000, 100_000, 0, 0),
+    ];
+    // Moving the pointer moves the USER's pointer on a live desktop, so the
+    // physical part is gated. The parse-only half below is always safe because
+    // a rejected button never reaches ydotool.
+    if input_armed() {
+        for (x1, y1, x2, y2) in cases {
+            let _ = linux::mouse_move(x1, y1);
+            let _ = linux::mouse_drag(x1, y1, x2, y2, "left");
+        }
+    } else {
+        eprintln!("skipped: pointer motion needs QUIXI_INPUT_TEST=1 (it moves the real cursor)");
+    }
+    assert!(linux::mouse_click("bogus", 1).is_err(), "bad click button must Err");
+    assert!(
+        linux::mouse_drag(0, 0, 10, 10, "bogus").is_err(),
+        "bad drag button must Err"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Screenshots: bad geometry must clamp or refuse, never panic or allocate wild
+// ---------------------------------------------------------------------------
+
+#[test]
+fn degenerate_capture_geometry_is_handled() {
+    for (x, y, w, h) in [
+        (0, 0, 0, 0),
+        (0, 0, -100, -100),
+        (-50, -50, 10, 10),
+        (i32::MAX, i32::MAX, 10, 10),
+    ] {
+        match linux::screenshot_region_png(x, y, w, h) {
+            Ok(bytes) => assert!(!bytes.is_empty(), "a successful capture must return bytes"),
+            Err(e) => assert!(!format!("{e}").is_empty(), "an error must carry a message"),
+        }
+    }
+}
+
+#[test]
+fn full_screenshot_is_a_png() {
+    let png = linux::screenshot_png().expect("screenshot on a live desktop must work");
+    assert_eq!(&png[..8], b"\x89PNG\r\n\x1a\n", "must be a real PNG, not raw bytes");
+}
+
+// ---------------------------------------------------------------------------
+// Clipboard: unicode, empties, and the deadlock that used to hang forever
+// ---------------------------------------------------------------------------
+
+#[test]
+fn clipboard_roundtrips_unicode_and_boundaries() {
+    let cases = [
+        String::new(),
+        " ".to_string(),
+        "héllo → 漢字 🙂".to_string(),
+        "line1\nline2\ttabbed".to_string(),
+        "x".repeat(64 * 1024),
+    ];
+    for case in cases {
+        // A 32-minute hang lived here once; a timeout is the regression test.
+        let start = std::time::Instant::now();
+        linux::clipboard_write(&case).expect("clipboard_write must not fail");
+        assert!(
+            start.elapsed().as_secs() < 10,
+            "clipboard_write must not block; took {:?}",
+            start.elapsed()
+        );
+        let back = linux::clipboard_read().unwrap_or_default();
+        assert_eq!(back, case, "clipboard must round-trip byte-for-byte");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Application launching: injection and traversal are the risks
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unknown_applications_error_rather_than_succeed() {
+    for name in ["definitely-not-installed-xyz", "", "   ", "..", "/etc/passwd"] {
+        let r = linux::open_application(name);
+        assert!(r.is_err(), "open_application({name:?}) must not claim success");
+    }
+}
+
+#[test]
+fn shell_metacharacters_are_not_executed() {
+    // If the launcher ever shells out unquoted, these create a marker file.
+    let marker = "/tmp/quixi_injection_marker";
+    let _ = std::fs::remove_file(marker);
+    for name in [
+        "x; touch /tmp/quixi_injection_marker",
+        "x && touch /tmp/quixi_injection_marker",
+        "$(touch /tmp/quixi_injection_marker)",
+        "`touch /tmp/quixi_injection_marker`",
+        "x | tee /tmp/quixi_injection_marker",
+    ] {
+        let _ = linux::open_application(name);
+        assert!(
+            !std::path::Path::new(marker).exists(),
+            "shell injection through app name: {name:?}"
+        );
+    }
+}
+
+#[test]
+fn app_listing_is_well_formed() {
+    let apps = linux::installed_apps();
+    assert!(!apps.is_empty(), "a desktop box should list some applications");
+    for (name, exec, desktop_id) in &apps {
+        assert!(!name.trim().is_empty(), "every app needs a display name");
+        assert!(!exec.trim().is_empty(), "app {name:?} has an empty Exec");
+        assert!(
+            !desktop_id.contains('\n'),
+            "desktop id must be a single token: {desktop_id:?}"
+        );
+        assert!(
+            !name.contains('\u{0}'),
+            "display names must not contain NUL"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Displays and capabilities: honesty, not optimism
+// ---------------------------------------------------------------------------
+
+#[test]
+fn every_advertised_capability_has_a_backing_tool() {
+    let c = linux::capabilities();
+    // If we claim input synthesis, ydotool must actually be resolvable.
+    if c.input_synthesis {
+        let found = ["/usr/bin/ydotool", "/usr/local/bin/ydotool", "/usr/sbin/ydotool", "/bin/ydotool"]
+            .iter()
+            .any(|p| std::path::Path::new(p).is_file());
+        assert!(found, "capability claims input synthesis but ydotool is not installed");
+    }
+    if c.screenshot {
+        assert!(
+            std::path::Path::new("/usr/bin/spectacle").is_file()
+                || std::path::Path::new("/usr/bin/grim").is_file()
+                || std::path::Path::new("/usr/bin/scrot").is_file(),
+            "capability claims screen capture with no capture tool present"
+        );
+    }
+}
+
+#[test]
+fn display_geometry_is_plausible() {
+    let ds = linux::displays();
+    assert!(!ds.is_empty(), "a graphical session must report a display");
+    for d in &ds {
+        assert!(d.width > 0 && d.height > 0, "display {d:?} has zero size");
+        assert!(
+            d.width < 100_000 && d.height < 100_000,
+            "display {d:?} has absurd geometry"
+        );
+    }
+    // The JSON form is an OBJECT with a "displays" array (kscreen-doctor emits
+    // {"outputs": [...]} and we normalise it). Assert the documented shape and,
+    // more importantly, that the two display APIs cannot drift apart.
+    let json = linux::list_displays_json().expect("displays must serialize");
+    let arr = json
+        .get("displays")
+        .and_then(|d| d.as_array())
+        .unwrap_or_else(|| panic!("list_displays_json must return {{\"displays\": [...]}}, got {json}"));
+    assert_eq!(
+        arr.len(),
+        ds.len(),
+        "displays() and list_displays_json() disagree: {} vs {}",
+        ds.len(),
+        arr.len()
+    );
+    for entry in arr {
+        assert!(
+            entry.get("name").and_then(|n| n.as_str()).map(|n| !n.is_empty()).unwrap_or(false),
+            "every display entry needs a non-empty name: {entry}"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Concurrency: the layer is called from async workers
+// ---------------------------------------------------------------------------
+
+#[test]
+fn concurrent_probes_are_safe() {
+    let mut handles = Vec::new();
+    for _ in 0..16 {
+        handles.push(std::thread::spawn(|| {
+            let c = linux::capabilities();
+            let d = linux::displays();
+            (c.input_synthesis, d.len())
+        }));
+    }
+    for h in handles {
+        let (_, n) = h.join().expect("a concurrent probe must not panic");
+        assert!(n >= 1);
+    }
+}
--- a/crates/quixi-platform/tests/capture_modes.rs
+++ b/crates/quixi-platform/tests/capture_modes.rs
@@ -0,0 +1,78 @@
+// Prove the two capture modes QuixiDesk offers, on this desktop.
+//
+//   whole frame   -> screenshot_png()                  (the "whole page" option)
+//   fine-tuned    -> screenshot_region_png(x,y,w,h)    (the "just what's in the box"
+//                                                       option)
+//
+// Both must go through KWin's ScreenShot2 fast path, both must produce a valid
+// PNG, and the region must be cheaper than the full frame — the old
+// capture-everything-then-crop path made a small region MORE expensive than the
+// whole screen, which is backwards for the one case people use constantly.
+
+#![cfg(target_os = "linux")]
+
+use quixi_platform::linux;
+use std::time::Instant;
+
+fn png_dims(bytes: &[u8]) -> (u32, u32) {
+    // PNG IHDR: 8-byte signature, 4-byte length, "IHDR", then w and h big-endian.
+    assert_eq!(&bytes[..8], b"\x89PNG\r\n\x1a\n", "not a PNG");
+    let w = u32::from_be_bytes([bytes[16], bytes[17], bytes[18], bytes[19]]);
+    let h = u32::from_be_bytes([bytes[20], bytes[21], bytes[22], bytes[23]]);
+    (w, h)
+}
+
+#[test]
+fn whole_frame_and_region_are_both_fast_and_valid() {
+    // warm up: first D-Bus call pays connection setup
+    let _ = linux::screenshot_png();
+
+    let mut full_times = Vec::new();
+    let mut full_bytes = Vec::new();
+    for _ in 0..5 {
+        let t = Instant::now();
+        let png = linux::screenshot_png().expect("full capture");
+        full_times.push(t.elapsed().as_secs_f64() * 1000.0);
+        full_bytes.push(png.len());
+    }
+    let full_ms = median(&full_times);
+    let fw_fh = png_dims(&linux::screenshot_png().expect("full capture"));
+
+    let mut reg_times = Vec::new();
+    let mut reg_sizes = Vec::new();
+    for _ in 0..5 {
+        let t = Instant::now();
+        let png = linux::screenshot_region_png(400, 300, 256, 256).expect("region capture");
+        reg_times.push(t.elapsed().as_secs_f64() * 1000.0);
+        reg_sizes.push(png.len());
+    }
+    let reg_ms = median(&reg_times);
+    let rw_rh = png_dims(&linux::screenshot_region_png(400, 300, 256, 256).expect("region"));
+
+    println!(
+        "whole frame : {:>7.1} ms  {:>8} bytes  {}x{}",
+        full_ms,
+        full_bytes.iter().max().unwrap(),
+        fw_fh.0,
+        fw_fh.1
+    );
+    println!(
+        "256x256 crop: {:>7.1} ms  {:>8} bytes  {}x{}",
+        reg_ms,
+        reg_sizes.iter().max().unwrap(),
+        rw_rh.0,
+        rw_rh.1
+    );
+    println!("speedup     : {:.1}x", full_ms / reg_ms.max(0.001));
+
+    assert_eq!(rw_rh, (256, 256), "region must be exactly the rectangle asked for");
+    assert!(reg_ms < full_ms, "region ({reg_ms:.1}ms) should beat full ({full_ms:.1}ms)");
+    assert!(full_ms < 200.0, "full frame at {full_ms:.0}ms is not the fast path");
+    assert!(reg_ms < 100.0, "region at {reg_ms:.0}ms is not the fast path");
+}
+
+fn median(v: &[f64]) -> f64 {
+    let mut s = v.to_vec();
+    s.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    s[s.len() / 2]
+}
--- a/crates/quixi-platform/tests/common/mod.rs
+++ b/crates/quixi-platform/tests/common/mod.rs
@@ -0,0 +1,68 @@
+// Shared helpers for the input-touching test binaries.
+//
+// The recurring failure mode in this suite is not broken code: synthetic input
+// goes to whatever window has focus, and a test earlier in the run (a mouse
+// click, another binary's click) moves that focus somewhere useless. The result
+// reads as "the input layer is broken" when delivery was perfect.
+//
+// So the tests focus their own target instead of trusting whatever the operator
+// left behind. This is KDE-specific and entirely best-effort: on any other
+// desktop it prints a warning and the caller carries on.
+
+#![allow(dead_code)]
+
+use std::process::Command;
+
+/// Activate the first Konsole window, if we can. Returns true when a focus
+/// attempt was made and reported success.
+pub fn focus_terminal() -> bool {
+    // Only do this when the operator has armed input tests at all.
+    if !matches!(
+        std::env::var("QUIXI_INPUT_TEST").ok().as_deref(),
+        Some("1") | Some("true") | Some("yes")
+    ) {
+        return false;
+    }
+    if Command::new("qdbus6").arg("--help").output().is_err() {
+        eprintln!("focus_terminal: qdbus6 not available, relying on the operator's focus");
+        return false;
+    }
+
+    // No `return` inside the loop: a top-level `return` in a KWin script is a
+    // syntax error and the whole script silently never runs.
+    let script = r#"
+var ws = workspace.windowList ? workspace.windowList() : [];
+for (var i = 0; i < ws.length; i++) {
+  var w = ws[i];
+  if (!w) continue;
+  var cap = String(w.caption).toLowerCase();
+  if (cap.indexOf("konsole") === -1 && cap.indexOf("terminal") === -1) continue;
+  try { w.activate(); print("FOCUSED " + w.caption); } catch (e) { print("ERR " + e); }
+}
+"#;
+    let path = format!("/tmp/quixi-focus-{}.js", std::process::id());
+    if std::fs::write(&path, script).is_err() {
+        return false;
+    }
+    let loaded = Command::new("qdbus6")
+        .args([
+            "org.kde.KWin",
+            "/Scripting",
+            "org.kde.kwin.Scripting.loadScript",
+            &path,
+            "quixi-focus",
+        ])
+        .output();
+    let started = Command::new("qdbus6")
+        .args(["org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.start"])
+        .output();
+    let _ = std::fs::remove_file(&path);
+    let ok = matches!(loaded, Ok(ref o) if o.status.success())
+        && matches!(started, Ok(ref o) if o.status.success());
+    if ok {
+        std::thread::sleep(std::time::Duration::from_millis(400));
+    } else {
+        eprintln!("focus_terminal: KWin scripting unavailable, relying on the operator's focus");
+    }
+    ok
+}
--- a/crates/quixi-platform/tests/compat_desktops.rs
+++ b/crates/quixi-platform/tests/compat_desktops.rs
@@ -0,0 +1,175 @@
+// Desktop-environment compatibility, proven without those desktops installed.
+//
+// A GNOME or Sway user does not have KDE's ScreenShot2, and may not have the tool
+// this chain reaches for first. What actually breaks them is *selection*: picking a
+// backend that cannot work, or giving up on the first failure while another backend
+// sits there unused. So each test builds a PATH containing exactly the tools that
+// desktop ships and checks the outcome.
+//
+// Run with --test-threads=1: these mutate PATH and the process environment.
+
+#![cfg(target_os = "linux")]
+
+use std::path::{Path, PathBuf};
+
+fn write_png(path: &Path) {
+    let file = std::fs::File::create(path).expect("create png");
+    let w = std::io::BufWriter::new(file);
+    let mut enc = png::Encoder::new(w, 2, 2);
+    enc.set_color(png::ColorType::Rgba);
+    enc.set_depth(png::BitDepth::Eight);
+    let mut writer = enc.write_header().expect("png header");
+    writer
+        .write_image_data(&[255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 0, 255])
+        .expect("png data");
+}
+
+/// A stand-in executable that behaves like the real tool for our purposes: it either
+/// writes a valid PNG to the path it was given, or fails the way the real one does.
+fn make_tool(dir: &Path, name: &str, writes_png: bool) {
+    let body = if writes_png {
+        format!(
+            "#!/bin/sh\n# pretend {name}: last argument is the output path\nfor a in \"$@\"; do out=\"$a\"; done\n\
+             printf '\\211PNG\\r\\n\\032\\n' > \"$out\"\n\
+             dd if=/dev/zero bs=1 count=64 >> \"$out\" 2>/dev/null\nexit 0\n"
+        )
+    } else {
+        format!("#!/bin/sh\necho \"{name}: cannot open display\" >&2\nexit 1\n")
+    };
+    let p = dir.join(name);
+    std::fs::write(&p, body).expect("write tool");
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+}
+
+/// Point PATH at exactly `dir` and make sure KDE's ScreenShot2 is unreachable, so the
+/// fallback chain is what runs.
+fn isolate(dir: &Path, desktop: &str) {
+    std::env::set_var("PATH", dir);
+    // Backend selection is session-aware now, so a test MUST say which desktop it is
+    // simulating. Inheriting the runner's XDG_CURRENT_DESKTOP made every scenario look
+    // like KDE and produced five false failures.
+    std::env::set_var("XDG_CURRENT_DESKTOP", desktop);
+    std::env::remove_var("DBUS_SESSION_BUS_ADDRESS");
+    std::env::remove_var("XDG_RUNTIME_DIR");
+}
+
+fn scratch(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("quixi-de-{}-{}", name, std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).expect("scratch dir");
+    d
+}
+
+#[test]
+fn gnome_session_captures_with_gnome_screenshot() {
+    let d = scratch("gnome");
+    make_tool(&d, "gnome-screenshot", true);
+    isolate(&d, "GNOME");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let bytes = std::fs::read(&out).unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&d);
+    r.expect("a GNOME session must capture via gnome-screenshot");
+    assert!(bytes.starts_with(b"\x89PNG"), "must be a PNG");
+}
+
+#[test]
+fn wlroots_session_captures_with_grim() {
+    let d = scratch("sway");
+    make_tool(&d, "grim", true);
+    isolate(&d, "Sway");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let bytes = std::fs::read(&out).unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&d);
+    r.expect("a wlroots session must capture via grim");
+    assert!(bytes.starts_with(b"\x89PNG"), "must be a PNG");
+}
+
+/// Cinnamon ships neither spectacle nor grim — it has its own screenshot tool. It is an
+/// X11 desktop (Muffin, a Mutter fork), so this is the same class as XFCE/i3, and the
+/// backend just has to be recognised by name.
+#[test]
+fn cinnamon_session_captures_with_cinnamon_screenshot() {
+    let d = scratch("cinnamon");
+    make_tool(&d, "cinnamon-screenshot", true);
+    isolate(&d, "Cinnamon");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let bytes = std::fs::read(&out).unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&d);
+    r.expect("a Cinnamon session must capture via cinnamon-screenshot");
+    assert!(bytes.starts_with(b"\x89PNG"), "must be a PNG");
+}
+
+/// XFCE is X11 like Cinnamon, but it ships `xfce4-screenshooter` and a bare XFCE has
+/// neither imagemagick nor gnome-screenshot. Without its own backend the desktop we claim
+/// to support cannot capture at all.
+#[test]
+fn xfce_session_captures_with_xfce4_screenshooter() {
+    let d = scratch("xfce");
+    make_tool(&d, "xfce4-screenshooter", true);
+    isolate(&d, "XFCE");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let bytes = std::fs::read(&out).unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&d);
+    r.expect("an XFCE session must capture via xfce4-screenshooter");
+    assert!(bytes.starts_with(b"\x89PNG"), "must be a PNG");
+}
+
+/// The regression this file exists for: ONE failing backend must not abort the chain.
+///
+/// The original bug was a `bail!` after spectacle failed, so a machine with spectacle
+/// installed got a total capture failure while working backends sat unused. Scoping changed
+/// WHICH backend is next — inside a KDE session the fallback is `import`, not another
+/// desktop's tool — but the contract being tested is unchanged: keep going.
+#[test]
+fn a_failing_backend_falls_through_to_the_next_one() {
+    let d = scratch("fallthru");
+    make_tool(&d, "spectacle", false); // present, always fails
+    make_tool(&d, "import", true); // the same session's next option, works
+    isolate(&d, "KDE");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let bytes = std::fs::read(&out).unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&d);
+    r.expect("a failing spectacle must fall through to the next backend, not give up");
+    assert!(bytes.starts_with(b"\x89PNG"), "must be a PNG");
+}
+
+#[test]
+fn a_bare_session_reports_every_backend_it_tried() {
+    let d = scratch("bare");
+    isolate(&d, "");
+    // Unknown session: every backend is a candidate, so this exercises the full chain.
+    std::env::remove_var("XDG_CURRENT_DESKTOP");
+    let out = d.join("shot.png");
+    let r = quixi_platform::linux::capture_fallback_to(&out, None);
+    let _ = std::fs::remove_dir_all(&d);
+    let err = format!("{}", r.expect_err("no capture tool means no screenshot"));
+    // `which` falls back to the standard bin directories, so a tool that is installed
+    // on the host is still attempted here — what matters is that the failure names
+    // what was tried instead of returning a bare "capture failed".
+    assert!(
+        err.contains("capture") && (err.contains("spectacle") || err.contains("grim")),
+        "the error should name the backends it tried; got: {err}"
+    );
+}
+
+#[test]
+fn capabilities_report_no_capture_when_no_backend_exists() {
+    let d = scratch("caps");
+    isolate(&d, "");
+    std::env::remove_var("DISPLAY");
+    std::env::remove_var("WAYLAND_DISPLAY");
+    std::env::remove_var("XDG_SESSION_TYPE");
+    let caps = quixi_platform::linux::capabilities();
+    let _ = std::fs::remove_dir_all(&d);
+    assert!(
+        !caps.screenshot && !caps.screenshot_region,
+        "capabilities must not claim capture with no backend present: {caps:?}"
+    );
+    assert_eq!(caps.session_type, "none", "no DISPLAY and no WAYLAND_DISPLAY");
+}
--- a/crates/quixi-platform/tests/compat.rs
+++ b/crates/quixi-platform/tests/compat.rs
@@ -0,0 +1,161 @@
+// Compatibility: the layer must be harmless on machines that are not this one.
+//
+// The bug hunt proves the code survives hostile INPUT. This proves it survives a
+// hostile ENVIRONMENT — a different session type, a machine with none of the
+// helper tools, a headless box. The contract is:
+//
+//   * nothing panics;
+//   * a capability is never claimed without its backend;
+//   * every call that cannot work returns Err or None with a message, rather than
+//     pretending, hanging, or returning a plausible-looking lie.
+//
+// Run it in three environments (scripts/compat-bench.sh does this):
+//   * the live Wayland session
+//   * an X11-only session (Xvfb on DISPLAY=:99, no WAYLAND_DISPLAY, no session bus)
+//   * no session at all (both unset)
+
+#![cfg(target_os = "linux")]
+
+use quixi_platform::linux;
+
+fn env(name: &str) -> Option<String> {
+    std::env::var(name).ok().filter(|v| !v.is_empty())
+}
+
+/// What this process should think the session is.
+fn expected_session() -> &'static str {
+    if env("WAYLAND_DISPLAY").is_some() {
+        "wayland"
+    } else if env("DISPLAY").is_some() {
+        "x11"
+    } else {
+        "none"
+    }
+}
+
+#[test]
+fn session_is_classified_from_the_environment_not_guessed() {
+    let report = linux::capabilities();
+    println!(
+        "env: WAYLAND_DISPLAY={:?} DISPLAY={:?} DBUS={}",
+        env("WAYLAND_DISPLAY"),
+        env("DISPLAY"),
+        env("DBUS_SESSION_BUS_ADDRESS").is_some()
+    );
+    println!(
+        "probe: session={} screenshot={} ({}) clipboard={} input={} pickers={} displays={} apps={} launch={}",
+        report.session_type,
+        report.screenshot,
+        report.screenshot_backend,
+        report.clipboard,
+        report.input_synthesis,
+        report.file_pickers,
+        report.display_listing,
+        report.app_launch,
+        report.window_layout
+    );
+    let want = expected_session();
+    match want {
+        "wayland" => assert_eq!(report.session_type, "wayland"),
+        "x11" => assert_eq!(report.session_type, "x11"),
+        _ => assert!(
+            report.session_type == "none" || report.session_type == "unknown",
+            "headless classification was {:?}",
+            report.session_type
+        ),
+    }
+}
+
+#[test]
+fn capabilities_never_claim_a_backend_that_is_absent() {
+    let r = linux::capabilities();
+
+    if r.screenshot {
+        // Either the compositor provides it, or a capture tool must exist.
+        let tool = ["/usr/bin/spectacle", "/usr/bin/grim", "/usr/bin/gnome-screenshot", "/usr/bin/import"]
+            .iter()
+            .any(|p| std::path::Path::new(p).is_file());
+        let kwin = r.screenshot_backend == "kwin-screenshot2";
+        assert!(tool || kwin, "claimed {:?} with no backend present", r.screenshot_backend);
+    }
+
+    if r.input_synthesis {
+        let tool = ["/usr/bin/ydotool", "/usr/sbin/ydotool", "/usr/local/bin/ydotool"]
+            .iter()
+            .any(|p| std::path::Path::new(p).is_file());
+        assert!(tool, "claimed input synthesis with no ydotool present");
+    }
+
+    if r.clipboard {
+        let tool = ["/usr/bin/wl-copy", "/usr/bin/xclip", "/usr/bin/xsel"]
+            .iter()
+            .any(|p| std::path::Path::new(p).is_file());
+        assert!(tool, "claimed clipboard with no clipboard tool present");
+    }
+}
+
+#[test]
+fn every_call_returns_cleanly_or_fails_cleanly_but_never_panics() {
+    // Screenshots
+    match linux::screenshot_png() {
+        Ok(b) => assert!(!b.is_empty(), "successful capture returned no bytes"),
+        Err(e) => assert!(!format!("{e}").is_empty(), "an error must carry a message"),
+    }
+    match linux::screenshot_region_png(0, 0, 320, 200) {
+        Ok(b) => assert!(!b.is_empty()),
+        Err(e) => assert!(!format!("{e}").is_empty()),
+    }
+
+    // Clipboard: never panics, may be empty
+    let _ = linux::clipboard_read();
+    let _ = linux::clipboard_write("compat");
+
+    // Enumeration: must produce something plausible or nothing, never garbage
+    for d in linux::displays() {
+        assert!(d.width > 0 && d.height > 0);
+        assert!(d.width < 100_000 && d.height < 100_000);
+    }
+    for (name, exec, id) in linux::installed_apps() {
+        assert!(!name.trim().is_empty());
+        assert!(!exec.trim().is_empty());
+        assert!(!id.contains('\n'));
+    }
+
+    // Input and launching must refuse cleanly when unavailable.
+    for combo in ["return", "ctrl+c", "nonsense"] {
+        let _ = linux::press_key(combo, 1);
+    }
+    for btn in ["left", "right", "bogus"] {
+        let _ = linux::mouse_click(btn, 1);
+        let _ = linux::mouse_down(btn);
+        let _ = linux::mouse_up(btn);
+    }
+    // Empty text is a no-op; unmappable text is an error. Neither may panic.
+    let empty = linux::type_text("");
+    assert!(empty.is_ok(), "empty text must be a no-op, not an error");
+    let unmappable = linux::type_text("漢");
+    assert!(unmappable.is_err(), "unmappable text must be refused, not silently dropped");
+
+    assert!(linux::open_application("definitely-not-installed-xyz").is_err());
+    assert!(linux::list_displays_json().is_ok() || linux::list_displays_json().is_err());
+
+    // Pickers block on a dialog, so only the capability is checked here.
+    let _ = linux::active_output();
+    let _ = linux::x11_window_under_cursor();
+}
+
+#[test]
+fn repeated_calls_stay_stable_in_any_environment() {
+    // Fifty mixed calls: catches fd growth and state corruption under a session
+    // type the code was not developed against.
+    for _ in 0..50 {
+        let _ = linux::capabilities();
+        let _ = linux::screenshot_region_png(0, 0, 32, 32);
+        let _ = linux::clipboard_write("x");
+        let _ = linux::clipboard_read();
+        let _ = linux::press_key("nonsense", 1);
+    }
+    let fds = std::fs::read_dir("/proc/self/fd").map(|d| d.count()).unwrap_or(0);
+    println!("fd count after 250 mixed calls: {fds}");
+    assert!(fds < 200, "descriptor growth under repeated use: {fds}");
+}
--- a/crates/quixi-platform/tests/input_synthesis.rs
+++ b/crates/quixi-platform/tests/input_synthesis.rs
@@ -0,0 +1,89 @@
+// Input-synthesis tests. These type and click into whatever window has focus,
+// so they are NOT part of the default suite: they only run when
+// QUIXI_INPUT_TEST=1 and the operator has already focused a safe target (a
+// throwaway terminal). Run them on a machine where a stray keystroke costs
+// nothing — never on the user's working desktop.
+//
+// Sequence:
+//   1. open a terminal and focus it (KWin script or by hand)
+//   2. QUIXI_INPUT_TEST=1 cargo test --test input_synthesis -- --test-threads=1
+//
+// ORDER MATTERS and the names encode it. libtest runs single-threaded tests in
+// ALPHABETICAL order, not definition order, so the typing test is named `t1_`
+// and the mouse test `t4_`. The mouse test CLICKS, and a click focuses whatever
+// window is under the pointer -- on an unattended box that was System Settings,
+// so the typing test that followed typed a shell command into the System
+// Settings search field and looked like a total failure of the input layer when
+// nothing was actually broken. Anything that moves the pointer must run LAST.
+
+#![cfg(target_os = "linux")]
+
+use quixi_platform::linux;
+use std::path::Path;
+use std::time::Duration;
+
+fn armed() -> bool {
+    match std::env::var("QUIXI_INPUT_TEST").ok().as_deref() {
+        Some("1") | Some("true") | Some("yes") => true,
+        _ => {
+            eprintln!("skipped: set QUIXI_INPUT_TEST=1 and focus a scratch terminal first");
+            false
+        }
+    }
+}
+
+/// Proves type_text + press_key reach a real application: the typed command
+/// creates a file, and the file existing means a shell actually received it.
+#[test]
+fn t1_typing_reaches_the_focused_application() {
+    if !armed() {
+        return;
+    }
+    let proof = "/tmp/quixi_input_proof";
+    let _ = std::fs::remove_file(proof);
+
+    linux::type_text(&format!("touch {proof}")).expect("type_text must not error");
+    linux::press_key("return", 1).expect("press_key must not error");
+
+    // Give the shell time to run the command.
+    for _ in 0..40 {
+        if Path::new(proof).exists() {
+            println!("input reached the application: {proof} created");
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    panic!("typed command never executed — keystrokes did not reach the focused window");
+}
+
+/// Proves the mouse can be moved to an absolute position and clicked without
+/// erroring. It does not assert on cursor position: Wayland gives clients no
+/// way to read it back, so that would be a test that cannot observe its subject.
+#[test]
+fn t4_mouse_move_and_click_report_success() {
+    if !armed() {
+        return;
+    }
+    linux::mouse_move(400, 300).expect("mouse_move must not error");
+    std::thread::sleep(Duration::from_millis(100));
+    linux::mouse_click("left", 1).expect("mouse_click must not error");
+    linux::mouse_drag(400, 300, 600, 400, "left").expect("mouse_drag must not error");
+}
+
+/// Combos go through the module's own keycode builder, so this exercises the
+/// real mapping path rather than a shelled-out shortcut.
+#[test]
+fn t2_modifier_combo_is_accepted() {
+    if !armed() {
+        return;
+    }
+    // ctrl+a: select-all in a terminal. Harmless, and exercises a modifier pair.
+    linux::press_key("ctrl+a", 1).expect("ctrl+a must map and send");
+}
+
+/// A combo the module cannot map must error rather than silently doing nothing.
+#[test]
+fn t3_unmappable_combo_is_an_error() {
+    let err = linux::press_key("hyper+meta+qzx", 1).unwrap_err();
+    println!("unmappable combo rejected as expected: {err}");
+}
--- a/crates/quixi-platform/tests/launch.rs
+++ b/crates/quixi-platform/tests/launch.rs
@@ -0,0 +1,79 @@
+// End-to-end proof that application launching is done in-process.
+//
+// The old path shelled out to gtk-launch -> gio -> kioclient6. This test installs a
+// throwaway .desktop entry whose Exec touches a file, points XDG_DATA_DIRS at it,
+// and asserts the file appears. If the launch still went through an external
+// launcher, the test would pass on a machine that has one and fail on a machine
+// that does not — so it also asserts that the *spawn* was ours: the marker carries
+// the argument we passed, which gtk-launch would never have seen.
+
+#![cfg(target_os = "linux")]
+
+use quixi_platform::linux;
+
+#[test]
+fn launches_a_desktop_entry_by_spawning_its_exec_line() {
+    let base = std::env::temp_dir().join(format!("quixi-launch-{}", std::process::id()));
+    let apps = base.join("applications");
+    std::fs::create_dir_all(&apps).expect("temp data dir");
+
+    let marker = base.join("launched.marker");
+    let entry = apps.join("quixi-launch-probe.desktop");
+    std::fs::write(
+        &entry,
+        format!(
+            "[Desktop Entry]\n\
+             Type=Application\n\
+             Name=QuixiLaunchProbe\n\
+             Exec=/bin/sh -c \"printf launched-ok > {}\" %U\n",
+            marker.display()
+        ),
+    )
+    .expect("write desktop entry");
+
+    // Point the XDG search path at our throwaway tree, keeping the system one so
+    // other lookups in this process still behave.
+    let prev = std::env::var("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".into());
+    let new = format!("{}:{}", base.display(), prev);
+    std::env::set_var("XDG_DATA_DIRS", &new);
+
+    let result = linux::open_application("QuixiLaunchProbe");
+
+    // Give the spawned shell a moment; the launcher must not block on it.
+    let mut seen = false;
+    for _ in 0..40 {
+        if marker.exists() {
+            seen = true;
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    }
+
+    std::env::set_var("XDG_DATA_DIRS", prev);
+    let _ = std::fs::remove_dir_all(&base);
+
+    let report = match result {
+        Ok(r) => r,
+        Err(e) => panic!("open_application failed: {e}"),
+    };
+    println!("open_application -> {report}");
+    assert!(seen, "the Exec line never ran (report said: {report})");
+    assert!(
+        report.contains("/bin/sh"),
+        "the launch should name the command we spawned, got: {report}"
+    );
+    assert!(
+        !report.contains("gtk-launch") && !report.contains("gio") && !report.contains("kioclient6"),
+        "launch fell back to an external launcher instead of spawning directly: {report}"
+    );
+}
+
+#[test]
+fn unknown_applications_still_fail_cleanly() {
+    for name in ["definitely-not-installed-xyz", "", "   ", "../etc/passwd"] {
+        let r = linux::open_application(name);
+        assert!(r.is_err(), "open_application({name:?}) must not claim success");
+        let msg = format!("{}", r.unwrap_err());
+        assert!(!msg.trim().is_empty(), "the error must carry a message");
+    }
+}
