 .persona-chip { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .persona-page { max-width: 900px; }
+/* Reading the persona: monospace, because it is markdown and the shape of it matters, and scrollable
+   rather than clamped, because the point is that nothing is being hidden. */
+.persona-read {
+  margin-top: 10px;
+  max-height: 420px;
+  overflow: auto;
+  padding: 14px 16px;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--panel) 70%, transparent);
+  color: var(--text);
+  font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
+  font-size: 12px;
+  line-height: 1.55;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+.persona-shelf { display: grid; gap: 8px; margin-top: 10px; }
+.persona-shelf-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  padding: 9px 12px;
+  border: 1px solid var(--line);
+  border-radius: 9px;
+  background: var(--panel);
+}
+.persona-shelf-name { font-weight: 600; }
+
 .persona-status { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 14px 0 6px; }
 .persona-status strong { font-size: 15px; color: var(--text); }
