+    pub fn reset_first_run(&self) -> Value {
+        {
+            let mut st = self.state.write();
+            for p in st.providers.iter_mut() {
+                p.configured = false;
+                p.api_key_raw.clear();
+                p.api_key_masked.clear();
+                p.oauth_access_token.clear();
+                p.oauth_refresh_token.clear();
