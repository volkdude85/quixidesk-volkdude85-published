+/// The microphone, while dictation is running.
+///
+/// The talk service does not open the microphone itself; it transcribes what it is fed and keeps one
+/// owner at a time. Reading its `/state` without ever feeding it was the whole defect — the button
+/// said Listening and nothing was ever captured. This owns the microphone properly: claim, capture,
+/// stream, release.
+struct Capture {
+    child: Child,
+    stop: Arc<AtomicBool>,
+}
+
+static CAPTURE: OnceLock<Mutex<Option<Capture>>> = OnceLock::new();
+
+fn capture_cell() -> &'static Mutex<Option<Capture>> {
+    CAPTURE.get_or_init(|| Mutex::new(None))
+}
+
+const CAPTURE_CLIENT: &str = "quixidesk";
+const CAPTURE_RATE: &str = "16000";
+
+fn stt_url(cfg: &VoiceConfig) -> Result<String, String> {
+    match &cfg.stt {
+        Stt::StreamingStt { url } => Ok(url.trim_end_matches('/').to_string()),
+        Stt::Command(_) => Err("this backend reads a command's stdout; there is no microphone to open".into()),
+        Stt::Off => Err("speech-to-text is off".into()),
+    }
+}
+
+fn post(url: &str, body: Vec<u8>) -> Result<(), String> {
+    let client = http(std::time::Duration::from_secs(15))?;
+    client
+        .post(url)
+        .header("content-type", "application/octet-stream")
+        .body(body)
+        .send()
+        .map(|_| ())
+        .map_err(|e| format!("{e}"))
+}
+
+/// Take the recognizer and start feeding it the microphone.
+pub fn start_capture(cfg: &VoiceConfig) -> Result<String, String> {
+    let url = stt_url(cfg)?;
+    {
+        let cell = capture_cell().lock().map_err(|_| "capture state poisoned".to_string())?;
+        if cell.is_some() {
+            return Ok("already listening".into());
+        }
+    }
+    // Claim before the microphone opens: a chunk that arrives before the claim is refused, and the
+    // first word of a sentence is exactly the chunk that would be lost.
+    let client = http(std::time::Duration::from_secs(5))?;
+    // The talk service reads the owner name from the JSON body of /claim (not from the query, which
+    // is only used by /chunk). Sending it in the query claimed the microphone as "anon" and then had
+    // every chunk refused as somebody else's — a running capture that delivers nothing.
+    client
+        .post(format!("{url}/claim"))
+        .json(&serde_json::json!({ "client": CAPTURE_CLIENT }))
+        .send()
+        .map_err(|e| format!("could not reach the talk service: {e}"))?;
+
+    let mut child = Command::new("parecord")
+        .args([
+            "--raw",
+            "--format=s16le",
+            "--rate",
+            CAPTURE_RATE,
+            "--channels=1",
+            "--latency-msec=100",
+        ])
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|e| format!("could not open the microphone (parecord): {e}"))?;
+    let mut stdout = child.stdout.take().ok_or_else(|| "parecord produced no stream".to_string())?;
+
+    let stop = Arc::new(AtomicBool::new(false));
+    let stop_flag = Arc::clone(&stop);
+    let feed_url = format!("{url}/chunk?client={CAPTURE_CLIENT}");
+    std::thread::spawn(move || {
+        // 100 ms of s16le mono 16 kHz. Small enough that a word lands promptly, large enough that the
+        // service is not handling a request every few milliseconds.
+        let mut buffer = [0u8; 3200];
+        while !stop_flag.load(Ordering::Relaxed) {
+            match stdout.read(&mut buffer) {
+                Ok(0) => break,
+                Ok(n) => {
+                    if post(&feed_url, buffer[..n].to_vec()).is_err() {
+                        // A dropped chunk is not fatal; the recognizer simply hears a gap.
+                        std::thread::sleep(std::time::Duration::from_millis(20));
+                    }
+                }
+                Err(_) => break,
+            }
+        }
+    });
+
+    let mut cell = capture_cell().lock().map_err(|_| "capture state poisoned".to_string())?;
+    *cell = Some(Capture { child, stop });
+    Ok("listening".into())
+}
+
+/// Stop the microphone and give the recognizer back.
+pub fn stop_capture(cfg: &VoiceConfig) -> Result<String, String> {
+    let taken = {
+        let mut cell = capture_cell().lock().map_err(|_| "capture state poisoned".to_string())?;
+        cell.take()
+    };
+    if let Some(mut capture) = taken {
+        capture.stop.store(true, Ordering::Relaxed);
+        let _ = capture.child.kill();
+        let _ = capture.child.wait();
+    }
+    if let Ok(url) = stt_url(cfg) {
+        if let Ok(client) = http(std::time::Duration::from_secs(3)) {
+            let _ = client
+                .post(format!("{url}/release"))
+                .query(&[("client", CAPTURE_CLIENT)])
+                .send();
+        }
+    }
+    Ok("stopped".into())
+}
+
+/// Whether the microphone is open right now.
+pub fn capturing() -> bool {
+    capture_cell().lock().map(|c| c.is_some()).unwrap_or(false)
+}
