+    /// On Linux the advertised Computer Use surface must not contain a single Apple-shaped tool:
+    /// no Spaces, no TCC prompts, no accessibility tree, no Teach overlay. A tool that is offered and
+    /// fails is worse than an absence, because the model then describes this desktop as if it had
+    /// those things.
+    #[test]
+    #[cfg(not(target_os = "macos"))]
+    fn linux_computer_use_offers_no_macos_tools() {
+        let tools = McpHost::computer_use_tools();
+        let names: Vec<String> = tools
+            .iter()
+            .filter_map(|t| t.get("name").and_then(|n| n.as_str()).map(str::to_string))
+            .collect();
+        assert!(!names.is_empty(), "the Linux surface should still offer real tools");
+        for apple in McpHost::MACOS_ONLY_COMPUTER_USE {
+            assert!(
+                !names.iter().any(|n| n == apple),
+                "{apple} is a macOS capability and must not be advertised on Linux"
+            );
+        }
+        for real in ["screenshot", "left_click", "type", "key", "scroll"] {
+            assert!(names.iter().any(|n| n == real), "{real} should be offered on Linux");
+        }
+    }
