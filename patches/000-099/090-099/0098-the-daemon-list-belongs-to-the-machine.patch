-                ("Embedding index", "embed.service", Some(8082u16), "memory recall"),
-                ("Model server", "model.service", Some(8083u16), "local models"),
-                ("Vision", "vision.service", Some(8084u16), "looking at images"),
-                ("Input injection", "ydotoold", None, "the agent driving mouse and keyboard"),
