+    // The default window is 1280x840 logical. On a 1280x800 handheld — a Steam Deck in desktop mode is
+    // exactly that — the window is forty logical pixels taller than the screen, and the composer at the
+    // bottom lands off the display, where no window manager will scroll to it and the on-screen keyboard
+    // covers what is left. So the default is clamped to the monitor the window will actually open on,
+    // with room for a panel and a titlebar. On anything bigger than 1280x840 nothing changes.
+    let (mut win_w, mut win_h) = (1280.0_f64, 840.0_f64);
+    if let Some(monitor) = event_loop.primary_monitor() {
+        let screen = monitor.size().to_logical::<f64>(monitor.scale_factor());
+        win_w = win_w.min(screen.width - 40.0).max(480.0);
+        win_h = win_h.min(screen.height - 80.0).max(360.0);
+    }
+
     let mut win_builder = WindowBuilder::new()
