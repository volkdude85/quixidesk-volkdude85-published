+      // The workspace rules: this build ships one, and a project may override it with its own
+      // PROJECT-RULES.md. Read from the shipped resource so the panel works before anybody configures
+      // anything, and rendered as text with headings rather than as raw markdown soup.
+      function rulesInto(text){
+        const out=el("div",{class:"rules-body"});
+        const lines=String(text||"").split(/\r?\n/);
+        let list=null;
+        const inline=(node,frag)=>{const parts=String(frag).split(/(\*\*[^*]+\*\*|`[^`]+`)/g);
+          for(const part of parts){if(!part)continue;
+            if(part.startsWith("**")&&part.endsWith("**"))node.append(el("strong",{},part.slice(2,-2)));
+            else if(part.startsWith("`")&&part.endsWith("`"))node.append(el("code",{},part.slice(1,-1)));
+            else node.append(document.createTextNode(part));}return node;};
+        for(const line of lines){
+          const t=line.trim();
+          if(/^(-|\*)\s+/.test(t)){
+            if(!list){list=el("ul",{});out.append(list);}
+            list.append(inline(el("li",{}),t.replace(/^(-|\*)\s+/,"")));
+            continue;
+          }
+          list=null;
+          if(!t){continue;}
+          if(t.startsWith("### "))out.append(inline(el("h4",{}),t.slice(4)));
+          else if(t.startsWith("## "))out.append(inline(el("h3",{}),t.slice(3)));
+          else if(t.startsWith("# "))out.append(inline(el("h2",{}),t.slice(2)));
+          else if(t==="---")out.append(el("hr",{}));
+          else out.append(inline(el("p",{}),t));
+        }
+        return out;
+      }
