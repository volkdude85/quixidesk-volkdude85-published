 /* The standalone table reuses the wizard's table styling; it just needs room. */
 .first-run-table table { width: 100%; }
+
+/* ---- Projects: work on the left, the rules on the right ------------------------------------
+   The rules are a standing document, not a setting, so they get their own column beside the project
+   list: narrow enough not to crowd the cards, sticky so it stays put while the list scrolls, and
+   scrollable itself so a long rules file cannot push the page around. */
+.projects-layout {
+  display: grid;
+  /* The panel keeps its column on a normal window instead of collapsing under the list: at 960px,
+     which is how this app is often run, the list still gets 640 and the rules still read. */
+  grid-template-columns: minmax(0, 1fr) clamp(230px, 28%, 310px);
+  gap: 16px;
+  align-items: start;
+}
+.projects-main { min-width: 0; }
+.rules-panel {
+  position: sticky;
+  top: 8px;
+  max-height: calc(100vh - 140px);
+  overflow: auto;
+  padding: 14px 14px 10px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: var(--panel);
+  font-size: 12.5px;
+  line-height: 1.55;
+}
+.rules-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
+.rules-head h3 { margin: 0; font-size: 13px; letter-spacing: .02em; }
+.rules-source { color: var(--muted); font-size: 10.5px; }
+.rules-body h2 { font-size: 13px; margin: 14px 0 6px; }
+.rules-body h3 { font-size: 12px; margin: 12px 0 4px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
+.rules-body h4 { font-size: 12px; margin: 10px 0 3px; }
+.rules-body p { margin: 0 0 7px; color: var(--text); }
+.rules-body ul { margin: 0 0 8px 16px; padding: 0; }
+.rules-body li { margin: 0 0 4px; }
+.rules-body code { font-family: ui-monospace, monospace; font-size: 11px; background: var(--raised); padding: 1px 4px; border-radius: 4px; }
+.rules-body hr { border: 0; border-top: 1px solid var(--line); margin: 12px 0; }
+.rules-foot { margin-top: 10px; }
+@media (max-width: 720px) {
+  .projects-layout { grid-template-columns: minmax(0, 1fr); }
+  .rules-panel { position: static; max-height: none; }
+}
