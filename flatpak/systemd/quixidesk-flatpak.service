[Unit]
Description=Keep the QuixiDesk Flatpak equal to the newest published package
Documentation=file:///home/volkdude/Projects/quixidesk-published/flatpak/auto-flatpak.sh
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/volkdude/Projects/quixidesk-published
ExecStart=/home/volkdude/Projects/quixidesk-published/flatpak/auto-flatpak.sh --watch
Restart=always
RestartSec=10
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/volkdude
Nice=10

[Install]
WantedBy=default.target
