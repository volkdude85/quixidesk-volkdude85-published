+/// The port the bridge actually bound, set once by the server at startup.
+static BOUND_PORT: OnceLock<u16> = OnceLock::new();
+
+/// Record the port the bridge is listening on. The first call wins; a later one is ignored.
+pub fn set_automation_port(port: u16) {
+    let _ = BOUND_PORT.set(port);
+}
+
+/// Where the port in use is written, so anything outside this process can find a bridge that had to move.
+pub fn automation_port_file() -> PathBuf {
+    data_dir().join("automation.port")
+}
+
+/// The port to talk to: what this process bound, else what was recorded in the data folder, else the
+/// preferred default. The distinction exists because the default port is a convenience, not a guarantee —
+/// a second instance (a test profile, another edition, a packaged build beside a dev build) finds it taken
+/// and takes a free one instead, and a bridge nobody can address is not a bridge.
+pub fn automation_endpoint_port() -> u16 {
+    if let Some(port) = BOUND_PORT.get() {
+        return *port;
+    }
+    if let Ok(text) = std::fs::read_to_string(automation_port_file()) {
+        if let Ok(port) = text.trim().parse::<u16>() {
+            if port != 0 {
+                return port;
+            }
+        }
+    }
+    automation_port()
+}
