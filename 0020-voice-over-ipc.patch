+            ("Voice", "getStatus") => {
+                let cfg = quixi_engine::voice::VoiceConfig::load(&self.engine.data_dir);
+                quixi_engine::voice::status(&cfg)
+            }
+            ("Voice", "getTranscript") => {
+                let cfg = quixi_engine::voice::VoiceConfig::load(&self.engine.data_dir);
+                match quixi_engine::voice::transcript(&cfg) {
+                    Ok(text) => json!({ "transcript": text }),
+                    Err(error) => json!({ "transcript": "", "error": error }),
