+/// What the talk service is hearing right now: the live transcript, the input level, and whether it
+/// currently believes it is looking at speech. The level is the thing a person needs — without it a
+/// dictation button is a light that says "on" whether or not the microphone is in the room.
+pub fn progress(cfg: &VoiceConfig) -> Result<Value, String> {
+    let url = stt_url(cfg)?;
+    let client = http(std::time::Duration::from_secs(4))?;
+    let v: Value = client
+        .get(format!("{url}/state"))
+        .send()
+        .and_then(|r| r.json::<Value>())
+        .map_err(|e| format!("could not reach the talk service: {e}"))?;
+    Ok(json!({
+        "transcript": v["transcript"].as_str().unwrap_or(""),
+        "level": v["level"].as_f64().unwrap_or(0.0),
+        "in_speech": v["in_speech"].as_bool().unwrap_or(false),
+        "seconds_fed": v["seconds_fed"].as_f64().unwrap_or(0.0),
+        "chunks": v["chunks"].as_u64().unwrap_or(0),
+        "transcribing": v["transcribing"].as_bool().unwrap_or(false),
+    }))
+}
