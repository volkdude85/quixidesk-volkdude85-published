+/* A level meter while the microphone is open. Without it the button is a light that says "on"
+   whether or not the microphone can hear anything, which is the complaint it exists to answer. */
+.mic-meter {
+  display: inline-block;
+  width: 34px;
+  height: 5px;
+  border-radius: 3px;
+  background: color-mix(in srgb, var(--muted) 30%, transparent);
+  overflow: hidden;
+  vertical-align: middle;
+}
+.mic-meter[hidden] { display: none; }
+.mic-meter i {
+  display: block;
+  height: 100%;
+  width: 2%;
+  border-radius: 3px;
+  background: var(--muted);
+  transition: width 90ms linear, background 120ms linear;
+}
+.mic-meter.is-speech i { background: var(--accent); }
+
 .conversation-chip {
   font-size: 9px;
   letter-spacing: 0.12em;
