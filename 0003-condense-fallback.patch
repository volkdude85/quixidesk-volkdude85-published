     }
+    /// Reply by request content instead of by position.
+    ///
+    /// A scripted queue assumes one request per scripted slot, but a child agent shares this
+    /// server with its parent and makes its own calls, so the interleaving depends on how many
+    /// subagents are allowed. Keying off the request keeps the fixture correct at any limit.
+    fn server_by<F>(e: &QuixiEngine, reply: F) -> std::thread::JoinHandle<Vec<Value>>
+    where
+        F: Fn(&Value) -> Value + Send + 'static,
+    {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let addr = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        {
+            let mut st = e.provider_manager.state.write();
+            st.active_provider = "custom".into();
+            st.active_model = "child-fixture".into();
+            st.subagent_provider = "custom".into();
+            st.subagent_model = "child-fixture".into();
+            let p = st.providers.iter_mut().find(|p| p.id == "custom").unwrap();
+            p.configured = true;
+            p.selected_model = "child-fixture".into();
+            p.base_url = format!("http://{addr}/v1");
+            p.models.clear();
+        }
+        std::thread::spawn(move || {
+            let mut requests = vec![];
+            loop {
+                let deadline = std::time::Instant::now() + std::time::Duration::from_millis(400);
+                let mut stream = loop {
+                    if let Ok((s, _)) = listener.accept() {
+                        break s;
+                    }
+                    if std::time::Instant::now() >= deadline {
+                        return requests;
+                    }
+                    std::thread::sleep(std::time::Duration::from_millis(10));
+                };
+                stream.set_nonblocking(false).unwrap();
+                stream
+                    .set_read_timeout(Some(std::time::Duration::from_secs(5)))
+                    .unwrap();
+                let mut r = std::io::BufReader::new(stream.try_clone().unwrap());
+                let mut length = 0;
+                let mut line = String::new();
+                while r.read_line(&mut line).is_ok() && line != "\r\n" {
+                    if let Some(v) = line.to_lowercase().strip_prefix("content-length:") {
+                        length = v.trim().parse().unwrap();
+                    }
+                    line.clear();
+                }
+                let mut body = vec![0; length];
+                if r.read_exact(&mut body).is_err() {
+                    continue;
+                }
+                let request: Value = match serde_json::from_slice(&body) {
+                    Ok(v) => v,
+                    Err(_) => continue,
+                };
+                requests.push(request.clone());
+                let delta = reply(&request);
+                let end = if delta.get("tool_calls").is_some() {
+                    "tool_calls"
+                } else {
+                    "stop"
+                };
+                let out = format!(
+                    "data: {}\n\ndata: [DONE]\n\n",
+                    json!({"model":"child-fixture","choices":[{"delta":delta,"finish_reason":end}]})
+                );
+                write!(stream,"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",out.len(),out).unwrap();
+            }
+        })
+    }
