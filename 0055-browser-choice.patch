+/// Which browser gets an external link is a setting, not an opinion baked into the build.
+///
+/// The privacy crowd runs Firefox; a Chromium-family browser is the only kind the agent tooling can
+/// drive over CDP; and plenty of people run one of each for different reasons. So the order is:
+/// `QUIXI_BROWSER` (developer override) -> the `externalBrowser` preference -> the stock behaviour.
+#[cfg(target_os = "linux")]
+fn external_browser_preference() -> String {
+    let path = quixi_proto::paths::data_dir().join("preferences.json");
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        return "system".to_string();
+    };
+    let Ok(value) = serde_json::from_str::<Value>(&text) else {
+        return "system".to_string();
+    };
+    value
+        .get("externalBrowser")
+        .and_then(|v| v.as_str())
+        .map(|s| s.trim().to_ascii_lowercase())
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| "system".to_string())
+}
+
+/// The binaries to try for a chosen browser, and whether it is Chromium-family. The distinction
+/// matters: only a Chromium takes `--app=<url>`, which is what makes the link open as its own window
+/// instead of a tab inside a session the user already has open.
+#[cfg(target_os = "linux")]
+fn browser_candidates(preference: &str) -> (Vec<&'static str>, bool) {
+    match preference {
+        "brave" => (vec!["brave-browser", "brave", "brave-bin"], true),
+        "chromium" => (vec!["chromium", "chromium-browser"], true),
+        "chrome" => (vec!["google-chrome-stable", "google-chrome"], true),
+        "vivaldi" => (vec!["vivaldi-stable", "vivaldi"], true),
+        "firefox" => (vec!["firefox", "firefox-developer-edition"], false),
+        "librewolf" => (vec!["librewolf"], false),
+        "mullvad" => (vec!["mullvad-browser"], false),
+        _ => (
+            vec![
+                "brave-browser", "brave", "brave-bin", "chromium", "google-chrome-stable",
+                "google-chrome", "firefox", "firefox-developer-edition", "librewolf",
+                "mullvad-browser",
+            ],
+            true,
+        ),
+    }
+}
