+/* Brand block: the mark carries the accent, the words stay quiet. */
+.sidebar .brand { padding: 2px 6px 8px; gap: 10px; align-items: center; }
+.sidebar .brand img { width: 22px; height: 22px; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 45%, transparent)); }
+.sidebar .brand span { font-weight: 650; letter-spacing: .01em; }
+.sidebar .brand-caption { display: block; margin-top: 2px; font-size: 10.5px; letter-spacing: .09em;
+  text-transform: uppercase; color: var(--muted); font-weight: 500; }
+/* Nav rhythm: every row the same height, an accent rail on the active one. */
