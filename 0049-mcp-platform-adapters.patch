+    /// AppleScript is a macOS capability. An entry written by an older build (or carried over from
+    /// another machine) sat in the panel and failed on every call, which reads as "MCP does not
+    /// work here" rather than "this one adapter is macOS-only". Not seeding it is not enough — the
+    /// entry is already on disk. The built-in adapter is removed; a user's own server is not.
+    #[test]
+    #[cfg(not(target_os = "macos"))]
+    fn a_macos_only_builtin_server_is_purged_but_a_users_own_is_kept() {
+        let root = std::env::temp_dir().join(format!(
+            "quixi-mcp-applescript-{}",
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir_all(&root).unwrap();
+        let input = json!({"mcpServers": {
+            "applescript":{"command":"quixi-mcp-builtin","args":["--applescript"]},
+            "applescript-mine":{"command":"my-applescript-bridge","args":["--custom"]}
+        }});
+        fs::write(
+            root.join("quixi_desktop_config.json"),
+            serde_json::to_vec(&input).unwrap(),
+        )
+        .unwrap();
+        let host = McpHost::new_with_data_dir(&root);
+        let cfg = host.read_config();
+        assert!(
+            !cfg.mcp_servers.contains_key("applescript"),
+            "the built-in macOS-only adapter must not be offered on Linux"
+        );
+        assert_eq!(
+            cfg.mcp_servers["applescript-mine"].command, "my-applescript-bridge",
+            "a server the user defined is not ours to prune"
+        );
+        // And it stays gone across a restart, rather than being re-seeded.
+        let host = McpHost::new_with_data_dir(&root);
+        assert!(!host.read_config().mcp_servers.contains_key("applescript"));
+        fs::remove_dir_all(root).unwrap();
+    }
