+                        .get("description")
+                        .and_then(|d| d.as_str())
+                        .unwrap_or("")
+                        .to_string(),
+                    source: "hyprland".into(),
+                    custom: false,
+                });
+            }
+        }
+    }
+
+    // The two sources overlap by design; keep one row per key+action.
+    out.sort_by(|a, b| a.keys.cmp(&b.keys).then(a.action.cmp(&b.action)));
+    out.dedup_by(|a, b| a.keys == b.keys && a.action == b.action);
+    out
+}
