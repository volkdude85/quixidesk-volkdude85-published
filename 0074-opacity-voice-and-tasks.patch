+/// Window opacity, driven by the same number as the surfaces.
+///
+/// A stylesheet cannot make a window see-through, and once the window stopped being declared
+/// transparent there was nothing behind a panel except the app's own background — which in the
+/// dark palettes is within a few levels of the panel colour, so the dial moved a number nobody
+/// could see. The compositor CAN blend the whole window, and 1.0 there is exactly opaque: 100%
+/// stays honest and everything below it is real transparency over the real desktop.
+///
+/// The value arrives through the ordinary AppPreferences IPC (the UI writes `windowOpacity`), and
+/// this watches the preferences file it already reads for the browser choice rather than opening a
+/// second channel for one number. It runs on the GTK main loop, not a worker thread: `gdk::Window`
+/// is not `Send`, and the loop it belongs to is already ticking. A native Wayland surface has no
+/// such property — there the dial still moves the surfaces over the app's own backdrop.
+#[cfg(target_os = "linux")]
+fn start_window_opacity_watcher(window: &tao::window::Window) {
+    use gtk::glib;
+    use gtk::prelude::WidgetExt;
+    use tao::platform::unix::WindowExtUnix;
+
+    // Hold the GTK window, not its GdkWindow: the GdkWindow does not exist until the window is
+    // realized, and at this point in startup it is not. Asking for it again on every tick is the
+    // difference between a dial that works and one that silently does nothing.
+    let gtk_window = window.gtk_window().clone();
+    let path = quixi_proto::paths::data_dir().join("preferences.json");
+    let last = std::rc::Rc::new(std::cell::Cell::new(1.0_f64));
+    glib::timeout_add_local(std::time::Duration::from_millis(200), move || {
+        let pct = std::fs::read_to_string(&path)
+            .ok()
+            .and_then(|text| serde_json::from_str::<Value>(&text).ok())
+            .and_then(|value| value.get("windowOpacity").and_then(|v| v.as_f64()));
+        if let Some(pct) = pct {
+            let alpha = (pct / 100.0).clamp(0.05, 1.0);
+            if (last.get() - alpha).abs() >= 0.004 {
+                if let Some(gdk_window) = gtk_window.window() {
+                    gdk_window.set_opacity(alpha);
+                    last.set(alpha);
+                    tracing::info!("window opacity {:.2}", alpha);
+                }
+            }
+        }
+        glib::ControlFlow::Continue
+    });
+}
